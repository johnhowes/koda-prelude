{
  "name": "prelude",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Design (and later build) an application with an agent: pick a folder, chat, watch the design appear.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node start.js",
    "test": "node --test \"test/*.test.js\"",
    "skills": "node tools/copy-skills.js",
    "icons": "tauri icon server/public/icon.svg --output tauri/src-tauri/icons",
    "build:shell": "cd tauri/src-tauri && cargo build --release && node -e \"require('fs').mkdirSync('../../dist-shell',{recursive:true});require('fs').copyFileSync('target/release/prelude-shell.exe','../../dist-shell/Prelude.exe')\"",
    "test:shell": "cd tauri/src-tauri && cargo test",
    "check": "node tools/check.js"
  },
  "dependencies": {
    "@kodalang/core": "0.1.4",
    "eta": "4.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0"
  }
}
