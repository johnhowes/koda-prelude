{
  "/f/:project": { "view": "projects/page", "title": "Project", "data": "projects/:project" },
  "/f/:project/work": { "view": "projects/_work", "data": "projects/:project" },
  "/f/:project/app": { "view": "projects/_app", "data": "projects/:project" },
  "/f/:project/designs/new": { "view": "projects/_new-design", "title": "New design", "data": "projects/:project", "over": "/f/:project", "in": "modal" },
  "/f/:project/branches/:branch/publish": { "view": "projects/_publish", "title": "Push a branch", "data": "projects/:project/inProgress/:branch", "over": "/f/:project", "in": "modal" },

  "POST /f/:project/designs": {
    "add": "projects/:project/designs",
    "require": ["title"],
    "form": "projects/_new-design-fields",
    "answer": { "into": "modal?", "also": [{ "into": "main", "view": "projects/page", "data": "projects/:project" }] }
  },
  "POST /f/:project/branches/:branch/publish": {
    "update": "projects/:project/inProgress/:branch",
    "answer": {
      "into": "modal?",
      "also": [
        { "into": "main", "view": "projects/page", "data": "projects/:project" },
        { "into": "notice?", "view": "projects/_pushed", "data": "projects/:project/inProgress/:branch" }
      ]
    }
  },
  "POST /f/:project/branches/:branch/update": {
    "update": "projects/:project/inProgress/:branch",
    "answer": { "view": "projects/_work", "data": "projects/:project" }
  },
  "POST /f/:project/branches/:branch/abandon": {
    "update": "projects/:project/inProgress/:branch",
    "answer": { "view": "projects/_work", "data": "projects/:project" }
  },
  "POST /f/:project/branches/:branch/merge": {
    "remove": "projects/:project/inProgress/:branch",
    "answer": { "view": "projects/_work", "data": "projects/:project" }
  },
  "POST /f/:project/branches/:branch/start": {
    "update": "projects/:project/inProgress/:branch",
    "answer": { "view": "projects/_work", "data": "projects/:project" }
  },
  "POST /f/:project/app/build": {
    "update": "projects/:project/app",
    "answer": { "view": "projects/_app", "data": "projects/:project" }
  },
  "POST /f/:project/references": {
    "add": "projects/:project/references",
    "require": ["path"],
    "form": "projects/_reference-field",
    "answer": {
      "view": "projects/_reference-field", "data": "projects/:project",
      "also": [{ "into": "references", "view": "projects/_references", "data": "projects/:project" }]
    }
  },
  "POST /f/:project/references/:reference/remove": {
    "remove": "projects/:project/references/:reference",
    "answer": { "view": "projects/_references", "data": "projects/:project" }
  }
}
