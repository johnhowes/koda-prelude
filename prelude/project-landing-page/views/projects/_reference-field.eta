<%/* Add a folder for the agent to read: the path, typed or chosen. Refused,
     it comes back with what was typed and why; added, it comes back empty. */%>
<% const error = it.$errors?.path, value = error ? it.path ?? '' : ''; %>
<label class="label" for="reference-path">Add a folder</label>
<div class="inline">
  <input id="reference-path" name="path" value="<%= value %>" placeholder="C:\Projects\another-app" autocomplete="off" spellcheck="false"
         <% if (error) { %>ko-invalid-server="<%= error %>" aria-describedby="reference-error"<% } %>>
  <button class="btn small" type="button" data-pick-folder data-desktop-only>Choose…</button>
  <button class="btn small" type="submit">Add</button>
</div>
<% if (error) { %><span class="error" id="reference-error"><%= error %></span><% } %>
