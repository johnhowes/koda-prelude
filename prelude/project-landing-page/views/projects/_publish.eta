<%/* Push a design's branch, asked first in the modal: pushing publishes it
     (step 9). It says exactly what goes where. Pushed, the modal closes, the
     page shows the pull request open, and a notice says so. `it` is one of
     the project's inProgress. */%>
<% const w = it; %>
<div class="stack gap-4">
  <h2>Push <%= w.design.title %>?</h2>
  <div class="notice warn">
    <p>This pushes <code><%= w.branch %></code> to <code><%= w.remote.name %></code>, where others can see it, and opens a pull request for it into <%= w.into %>.</p>
    <% if (w.check !== 'passing') { %><p><%= w.check === 'failing' ? (w.failures === 1 ? '1 page doesn’t render yet.' : `${w.failures} pages don’t render yet.`) : 'Its check hasn’t run yet.' %> Reviewers will see the branch as it is.</p><% } %>
  </div>
  <form class="cluster actions" action="<%= w.finish %>/publish" method="post">
    <input type="hidden" name="confirm" value="yes">
    <input type="hidden" name="pushed" value="true">
    <button class="btn primary" type="submit"><span class="icon icon-push" aria-hidden="true"></span>Push and open the pull request</button>
    <button class="btn ghost" type="button" command="--koda-empty" commandfor="modal">Not now</button>
  </form>
</div>
