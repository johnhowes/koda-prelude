<%/* What the agent can read: the project, and the folders the person adds,
     such as another repository whose CSS a design system starts from. The
     list and the Add field are regions of their own, so adding one, or a
     path refused, changes only them. `it` is the project. */%>
<% const p = it; %>
<section class="card" id="reading" aria-labelledby="reading-title">
  <h2 id="reading-title">What the agent can read</h2>
  <p class="secondary">This project, and any folders you add here. Nothing else on this computer. The agent writes only inside the design it’s working on.</p>
  <ul class="list">
    <li>
      <span class="item">
        <span class="icon icon-folder" aria-hidden="true"></span>
        <span class="item-text"><span class="item-title">This project</span><span class="muted project-path"><%= p.path %></span></span>
      </span>
    </li>
  </ul>
  <div ko-as="references"><%~ include('./_references', p) %></div>
  <form class="stack gap-1" action="/f/<%= p.id %>/references" method="post" ko-target="referenceField">
    <div class="stack gap-1" ko-as="referenceField"><%~ include('./_reference-field', {}) %></div>
  </form>
</section>
