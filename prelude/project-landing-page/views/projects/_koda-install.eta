<%/* Install the Koda the app asks for in the project's own folder, asked
     first in the modal (D-k7v): after an upgrade is merged, package.json
     asks for the new version but the folder still has the old one
     installed. It's the one place Prelude changes the person's folder, and
     only `node_modules`, so it says exactly what runs and where. Clicking
     Install approves the command it shows (R-n6t). Started, the modal closes
     and the card says it's installing. Reached with nothing to install, it
     says so. `it` is the project. */%>
<% const p = it, koda = p.app?.koda, checkout = koda?.checkout; %>
<div class="stack gap-4">
<% if (checkout && checkout.state !== 'installing') { %>
  <h2>Install Koda <%= koda.wanted %> in your folder?</h2>
  <p class="secondary">The app asks for Koda <%= koda.wanted %>, but <%= p.name %>’s own folder has <%= koda.version %> installed, so the app you run from here still uses <%= koda.version %>.</p>
  <div class="notice warn">
    <p>Prelude runs <code><%= checkout.command %></code> in <% if (p.app.path) { %><code><%= p.app.path %>/</code> in <% } %><span class="project-path"><%= p.path %></span>. Installing runs code from the package registry. It changes only <code>node_modules</code>; nothing is committed.</p>
  </div>
  <form class="cluster actions" action="/f/<%= p.id %>/app/koda/install" method="post">
    <input type="hidden" name="state" value="installing">
    <input type="hidden" name="log" value="">
    <button class="btn primary" type="submit">Install Koda <%= koda.wanted %></button>
    <button class="btn ghost" type="button" command="--koda-empty" commandfor="modal">Not now</button>
  </form>
<% } else { %>
  <h2><%= checkout ? `Koda ${koda.wanted} is being installed` : 'Nothing to install' %></h2>
  <p class="secondary"><%= checkout ? 'The app card says when it’s done.' : koda ? `Your folder already has Koda ${koda.version}, the version the app asks for.` : 'This app doesn’t use Koda.' %></p>
  <div class="cluster actions">
    <button class="btn" type="button" command="--koda-empty" commandfor="modal">Back to the project</button>
  </div>
<% } %>
</div>
