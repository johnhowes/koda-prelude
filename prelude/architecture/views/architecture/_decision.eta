<%/* One decision, in the drawer: its context, what was decided and what
     follows, from decisions/<id>.md. A proposed one says where it was
     proposed, and that merging that branch accepts it; a superseded one
     names the decision that replaced it. */%>
<% const d = it, base = `/f/${d.project.id}/architecture`;
   const pill = { proposed: 'pill warn', accepted: 'pill', superseded: 'pill' }[d.status] ?? 'pill';
   const status = { proposed: 'Proposed', accepted: 'Accepted', superseded: 'Superseded' }[d.status] ?? d.status; %>
<article class="stack gap-5" ko-item>
  <div class="stack gap-2">
    <h2><%= d.title %></h2>
    <div class="cluster"><span class="<%= pill %>"><%= status %></span><span class="muted"><%= d.id %> · <%= d.date %></span></div>
  </div>

  <% if (d.proposedIn) { %>
  <div class="notice warn">
    <p>Proposed in <strong><%= d.proposedIn.title %></strong>, on <code><%= d.proposedIn.branch %></code>. Merging that branch into main accepts it; until then, agents on other branches don’t see it.</p>
  </div>
  <% } %>
  <% if (d.supersededBy) { %>
  <div class="notice">
    <p>Replaced by <a href="<%= base %>/decisions/<%= d.supersededBy.id %>" ko-target="drawer?"><%= d.supersededBy.title %></a> (<%= d.supersededBy.id %>).</p>
  </div>
  <% } %>

  <section class="stack gap-2" aria-labelledby="context-title">
    <h3 id="context-title" class="group-label">Context</h3>
    <div class="prose"><%~ d.context %></div>
  </section>
  <section class="stack gap-2" aria-labelledby="decision-title">
    <h3 id="decision-title" class="group-label">Decision</h3>
    <div class="prose"><%~ d.decision %></div>
  </section>
  <section class="stack gap-2" aria-labelledby="consequences-title">
    <h3 id="consequences-title" class="group-label">Consequences</h3>
    <div class="prose"><%~ d.consequences %></div>
  </section>
  <% if (d.supersedes) { %>
  <p class="secondary">Replaces <a href="<%= base %>/decisions/<%= d.supersedes.id %>" ko-target="drawer?"><%= d.supersedes.title %></a> (<%= d.supersedes.id %>).</p>
  <% } %>

  <section class="stack gap-2" aria-labelledby="binds-title">
    <h3 id="binds-title" class="group-label">Parts it binds</h3>
    <div class="cluster"><% for (const part of d.parts ?? []) { %><a class="btn small" href="<%= base %>/parts/<%= part.id %>"><%= part.title %></a><% } %></div>
  </section>
  <p class="muted">From <code><%= d.source %></code></p>
</article>
