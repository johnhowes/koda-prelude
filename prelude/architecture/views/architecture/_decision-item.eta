<%/* One decision in a list: its title and status, its id, date and the
     parts it binds. Opens in the drawer over the page it's listed on. */%>
<% const { decision, base } = it;
   const pill = { proposed: 'pill warn', accepted: 'pill', superseded: 'pill' }[decision.status] ?? 'pill';
   const status = { proposed: 'Proposed', accepted: 'Accepted', superseded: 'Superseded' }[decision.status] ?? decision.status; %>
<a class="item" href="<%= base %>/decisions/<%= decision.id %>" ko-target="drawer?">
  <span class="item-text">
    <span class="item-title"><%= decision.title %><span class="<%= pill %>"><%= status %></span></span>
    <span class="muted"><%= decision.id %> · <%= decision.date %><% if ((decision.parts ?? []).length) { %> · <%= decision.parts.map(part => part.title).join(', ') %><% } %></span>
  </span>
</a>
