<%/* The check, as a list: every screen of the page being built, in every
     state, against its approved screen; then the rest of the design, which a
     build can change too, listed only where it doesn't match (the rest
     counted). One notice
     says what to do first. Each screen opens in this panel to compare. It
     runs again after each of the agent's turns (check-done).
     `it` is the session. */%>
<% const check = it.check; const all = check.shots;
   const shots = all.filter(shot => shot.group === it.build.title);
   const others = all.filter(shot => shot.group !== it.build.title);
   const count = status => all.filter(shot => shot.status === status).length;
   const fails = count('fails'), differs = count('differs'), unbuilt = count('unbuilt');
   const pages = [...new Set(shots.map(shot => shot.page))];
   const says = {
     matches: { pill: 'good', label: 'Matches', line: 'As approved' },
     differs: { pill: 'warn', label: 'Differs', line: 'Looks different from its approved screen' },
     fails: { pill: 'danger', label: 'Doesn’t render', line: null },
     unbuilt: { pill: '', label: 'Not built yet', line: 'Still the design’s own view' },
   }; %>
<div class="stack gap-5">
  <% if (fails) { %>
  <div class="notice danger" role="alert">
    <p><strong><%= fails === 1 ? '1 screen doesn’t render.' : `${fails} screens don’t render.` %></strong> The agent is told with your next message.</p>
  </div>
  <% } else if (differs) { %>
  <div class="notice warn" role="status">
    <p><strong><%= differs === 1 ? '1 screen differs' : `${differs} screens differ` %> from the approved design.</strong> Open <%= differs === 1 ? 'it' : 'one' %> to compare. Ask the agent to fix it, or approve it as built if the change is what you want.</p>
  </div>
  <% } else if (!unbuilt && !it.status) { %>
  <div class="notice good" role="status">
    <strong><%= it.build.title %> is built.</strong>
    <p>Every screen matches its approved design. Try it in the app, with its own data, then finish the branch from the project’s page.</p>
    <div class="cluster actions"><%~ include('./_open-app', it.app) %></div>
  </div>
  <% } %>

  <% for (const page of pages) { %>
  <section class="stack gap-1" aria-label="<%= page %>">
    <h3 class="group-label"><%= page %></h3>
    <ul class="list">
      <% for (const shot of shots.filter(s => s.page === page)) { const s = says[shot.status]; %>
      <li><a class="item" href="<%= shot.url %>">
        <span class="icon icon-screen" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= shot.state %><span class="pill <%= s.pill %>"><%= s.label %></span></span>
          <span class="muted"><%= s.line ?? shot.error %></span>
        </span>
      </a></li>
      <% } %>
    </ul>
  </section>
  <% } %>

  <section class="stack gap-1" aria-label="The rest of the design">
    <h3 class="group-label">The rest of the design</h3>
    <% if (others.length) { %>
    <ul class="list">
      <% for (const shot of others) { const s = says[shot.status]; %>
      <li><a class="item" href="<%= shot.url %>">
        <span class="icon icon-screen" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= shot.page %> · <%= shot.state %><span class="pill <%= s.pill %>"><%= s.label %></span></span>
          <span class="muted"><%= s.line ?? shot.error %></span>
        </span>
      </a></li>
      <% } %>
    </ul>
    <% } %>
    <p class="muted"><%= others.length ? `The other ${check.elsewhere.matching}` : `All ${check.elsewhere.matching}` %> screens on <%= check.elsewhere.pages %> other pages match.</p>
  </section>

  <p class="muted" role="status"><%= it.status ? `The agent is working. The check runs again when its turn ends; this is from ${check.at}.` : `Checked ${check.at}, after the agent’s last turn.` %></p>
</div>
