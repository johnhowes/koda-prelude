<%/* The real app, from this branch, with its own data: opened in a window of
     its own to try it, never in the check, which shows the design's states.
     Stopped, it's started first: one address serves one branch at a time, so
     starting it here stops whichever branch had it. `it` is the app.
     The hidden `running` is the design's, so the preview shows it started;
     the app posts only `back`. */%>
<% if (it.running) { %>
<a class="btn small" href="<%= it.open %>" target="_blank" title="The app built on this branch, at <%= it.url %>, with its own data."><span class="icon icon-external" aria-hidden="true"></span>Open the app</a>
<% } else { %>
<form action="<%= it.start %>" method="post">
  <input type="hidden" name="back" value="<%= it.back %>">
  <input type="hidden" name="running" value="true">
  <button class="btn small" type="submit" title="Start the app from this branch at <%= it.url %>, with its own data. If another branch’s app is running there, it stops."><span class="icon icon-run" aria-hidden="true"></span>Start the app</button>
</form>
<% } %>
