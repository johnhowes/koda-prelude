{
  "/f/:folder/d/:design/build": { "view": "@app/server/views/_build", "title": "Build", "data": "folders/:folder/designs/:design" },
  "/f/:folder/d/:design/build/pages": { "view": "@app/server/views/build/_pages", "data": "folders/:folder/designs/:design" },
  "POST /f/:folder/d/:design/build/stories": {
    "update": "folders/:folder/designs/:design",
    "answer": { "redirect": "/f/:folder/d/:design/build" }
  },
  "POST /f/:folder/d/:design/builds": {
    "update": "folders/:folder/designs/:design",
    "answer": { "redirect": "/f/:folder/d/:design/build" }
  },
  "POST /f/:folder/d/:design/approve": {
    "update": "folders/:folder/designs/:design",
    "answer": { "redirect": "/f/:folder/d/:design/build" }
  },

  "/f/:folder/d/:design/build/stories/:group": { "view": "@app/server/views/build/story", "title": "A page’s story", "data": "folders/:folder/designs/:design/groups/:group" },
  "/f/:folder/d/:design/build/stories/:group/list": { "view": "@app/server/views/build/_stories", "data": "folders/:folder/designs/:design/groups/:group" },
  "/f/:folder/d/:design/build/stories/:group/rewrite": { "view": "@app/server/views/build/_rewrite", "title": "Rewrite the story", "data": "folders/:folder/designs/:design/groups/:group", "over": "/f/:folder/d/:design/build/stories/:group", "in": "modal" },
  "POST /f/:folder/d/:design/build/stories/:group": {
    "update": "folders/:folder/designs/:design/groups/:group",
    "answer": { "redirect": "/f/:folder/d/:design/build/stories/:group" }
  },

  "/f/:folder/d/:design/sessions/:session": { "view": "@app/server/views/build/session", "title": "Build session", "data": "folders/:folder/designs/:design/sessions/:session" },
  "/f/:folder/d/:design/sessions/:session/check": { "view": "@app/server/views/build/_check", "data": "folders/:folder/designs/:design/sessions/:session" },
  "/f/:folder/d/:design/sessions/:session/check/tally": { "view": "@app/server/views/build/_tally", "data": "folders/:folder/designs/:design/sessions/:session/check" },
  "/f/:folder/d/:design/sessions/:session/check/:shot": { "view": "@app/server/views/build/_shot", "data": "folders/:folder/designs/:design/sessions/:session/check/shots/:shot" },
  "POST /f/:folder/d/:design/sessions/:session/check/:shot/approve": {
    "update": "folders/:folder/designs/:design/sessions/:session/check/shots/:shot",
    "answer": {
      "view": "@app/server/views/build/_shot", "data": "folders/:folder/designs/:design/sessions/:session/check/shots/:shot",
      "also": [{ "into": "check-tally", "view": "@app/server/views/build/_tally", "data": "folders/:folder/designs/:design/sessions/:session/check" }]
    }
  },
  "POST /f/:folder/d/:design/sessions/:session/check/:shot/fix": {
    "add": "folders/:folder/designs/:design/sessions/:session/entries",
    "answer": { "view": "@app/server/views/build/_entry", "data": "folders/:folder/designs/:design/sessions/:session/entries/:new" }
  },
  "/f/:folder/d/:design/sessions/:session/result": { "view": "@app/server/views/build/_result", "data": "folders/:folder/designs/:design/sessions/:session" },
  "POST /f/:folder/d/:design/sessions/:session/result/fix": {
    "add": "folders/:folder/designs/:design/sessions/:session/entries",
    "answer": { "view": "@app/server/views/build/_entry", "data": "folders/:folder/designs/:design/sessions/:session/entries/:new" }
  },
  "POST /f/:folder/d/:design/sessions/:session/messages": {
    "add": "folders/:folder/designs/:design/sessions/:session/entries",
    "require": ["message"],
    "form": "@app/server/views/build/_composer",
    "answer": {
      "view": "@app/server/views/build/_composer", "data": "folders/:folder/designs/:design/sessions/:session",
      "also": [{ "into": "transcript", "view": "@app/server/views/build/_transcript", "data": "folders/:folder/designs/:design/sessions/:session" }]
    }
  },
  "POST /f/:folder/d/:design/sessions/:session/stop": {
    "update": "folders/:folder/designs/:design/sessions/:session",
    "answer": { "redirect": "/f/:folder/d/:design/sessions/:session" }
  },
  "POST /f/:folder/d/:design/sessions/:session/app/start": {
    "update": "folders/:folder/designs/:design/sessions/:session/app",
    "answer": { "redirect": "/f/:folder/d/:design/sessions/:session" }
  },

  "/f/:folder/d/:design/build/stories/:group/story/:story": { "view": "@app/server/views/build/_story", "data": "folders/:folder/designs/:design/groups/:group/story/stories/:story" },
  "/f/:folder/d/:design/build/stories/:group/story/:story/edit": { "view": "@app/server/views/build/_story-edit", "data": "folders/:folder/designs/:design/groups/:group/story/stories/:story" },
  "POST /f/:folder/d/:design/build/stories/:group/story/:story": {
    "update": "folders/:folder/designs/:design/groups/:group/story/stories/:story",
    "require": ["markdown"],
    "form": "@app/server/views/build/_story-edit",
    "answer": { "view": "@app/server/views/build/_story", "data": "folders/:folder/designs/:design/groups/:group/story/stories/:story" }
  }
}
