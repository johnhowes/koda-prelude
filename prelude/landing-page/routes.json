{
  "/": { "view": "@app/server/views/home/index", "title": "Home", "data": "" },
  "/loading": { "view": "home/loading", "title": "Home, while it loads", "data": "" },
  "/home/needs-you": { "view": "@app/server/views/home/_needs-you", "data": "" },
  "/home/projects": { "view": "@app/server/views/home/_projects", "data": "" },
  "/open": { "view": "@app/server/views/home/_open", "title": "Open a project", "data": "", "over": "/", "in": "modal" },
  "POST /folders": {
    "add": "projects",
    "require": ["path"],
    "form": "@app/server/views/home/_open",
    "answer": { "into": "modal?", "also": [{ "into": "main", "view": "@app/server/views/home/index", "data": "" }] }
  },
  "POST /folders/:id/remove": {
    "remove": "projects/:id",
    "answer": { "view": "@app/server/views/home/_projects", "data": "" }
  }
}
