<%/* A plan's page: one change carried through several designs, builds and
     the architecture. Its steps (what needs the person, then every step in
     the order they start) beside its brief, what it does by itself, and
     what's happened. The steps and the history reload when the server says
     a step moved (plans-changed, down the app's live channel).

     Drafted, nothing starts until the person starts the plan: that's the
     page's one primary action then. Running, it can be paused, which holds
     back steps that haven't started (R-c7n). The agent that drafted it is
     talked to in the plan's own session. */%>
<% const p = it, project = p.project, base = `/f/${project.id}/plans/${p.id}`, steps = p.steps ?? []; %>
<div class="center wide plan" ko-item>
  <div class="stack gap-8">
    <div class="cluster gap-4">
      <div class="stack gap-1">
        <nav class="crumbs" aria-label="Where you are"><a href="/">Projects</a><span aria-hidden="true">›</span><a href="/f/<%= project.id %>"><%= project.name %></a><span aria-hidden="true">›</span><a href="/f/<%= project.id %>/plans">Plans</a></nav>
        <h1><%= p.title || 'A new plan' %></h1>
        <% if (p.branch) { %><span class="muted" title="The plan itself is kept on a branch of its own, and goes into main when it finishes."><code><%= p.branch %></code></span><% } %>
      </div>
      <span class="spacer"></span>
      <% if (p.session) { %>
      <a class="btn" href="<%= p.session %>" title="The plan’s own session: ask the agent to add, remove or reorder steps, or to change the brief."><span class="icon icon-agent" aria-hidden="true"></span>Talk it over</a>
      <% } %>
      <% if (p.status === 'planning' && steps.length) { %>
      <form action="<%= base %>/start" method="post">
        <input type="hidden" name="status" value="running">
        <button class="btn primary" type="submit" title="Steps that wait for nothing start now; each of the others starts once what it waits for is merged into main."><span class="icon icon-run" aria-hidden="true"></span>Start the plan</button>
      </form>
      <% } else if (p.status === 'running') { %>
      <form action="<%= base %>/pause" method="post">
        <input type="hidden" name="status" value="paused">
        <button class="btn" type="submit" title="No step starts until you resume it. Steps already working carry on.">Pause</button>
      </form>
      <% } else if (p.status === 'paused') { %>
      <form action="<%= base %>/start" method="post">
        <input type="hidden" name="status" value="running">
        <button class="btn primary" type="submit"><span class="icon icon-run" aria-hidden="true"></span>Resume the plan</button>
      </form>
      <% } %>
    </div>

    <% if (p.status === 'planning' && steps.length) { %>
    <div class="notice" role="status">
      <p>The agent drafted <%= steps.length === 1 ? '1 step' : `${steps.length} steps` %> from what you asked for. Read them, change any step’s prompt, or talk it over with the agent. Nothing starts until you start the plan.</p>
    </div>
    <% } else if (p.status === 'paused') { %>
    <div class="notice warn" role="status">
      <strong>The plan is paused.</strong>
      <p>No step starts until you resume it. Steps already working carry on, and still ask you when they’re done.</p>
    </div>
    <% } else if (p.status === 'done') { %>
    <div class="notice good" role="status">
      <p>Finished <%= p.finished %>. Every step is merged into main.</p>
      <% if (p.branch) { %><p>The plan itself is on <code><%= p.branch %></code>: finish it from <a href="/f/<%= project.id %>">the project’s page</a>, as any branch, so main keeps it beside what it built.</p><% } %>
    </div>
    <% } %>

    <div class="split" style="--side: 20rem">
      <div class="stack gap-6">
        <div class="stack gap-6" id="planWork" ko-source="<%= base %>/work" ko-invoke="event:plans-changed"><%~ include('./_work', p) %></div>
        <div class="notice danger" role="alert" visible-when-unreachable="planWork">
          <p>Prelude couldn’t read where the plan’s steps stand. What’s shown may be out of date; try again in a moment.</p>
          <div class="cluster actions"><button class="btn small" type="button" command="--koda-retry" commandfor="planWork">Try again</button></div>
        </div>
      </div>
      <aside class="side stack gap-6" aria-label="About the plan">
        <section class="card" id="planBrief" ko-region aria-labelledby="brief-title"><%~ include('./_brief', p) %></section>
        <section class="card" id="planSettings" ko-region aria-labelledby="settings-title"><%~ include('./_settings', p) %></section>
        <section class="card" ko-source="<%= base %>/activity" ko-invoke="event:plans-changed" aria-labelledby="activity-title"><%~ include('./_activity', p) %></section>
      </aside>
    </div>
  </div>
</div>
