<%/* A design's page (the chat beside the design surface): the bar, then the
     page filling the rest of the window. The window doesn't scroll; the page's
     panels do, each its own. */%>
<!doctype html>
<html lang="en">
<head>
<%~ include('./_head', it) %>
</head>
<body class="shell fill">
<%~ include('./_bar', it.layout) %>
<main id="main" class="shell-main" ko-scope="/" ko-location="<%= it.location %>" ko-history><%~ it.body %></main>
<%~ include('./_regions', it) %>
</body>
</html>
