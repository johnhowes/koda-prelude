<%/* Sample content for the drawer: a fragment that starts with its own title. */%>
<div class="stack">
  <h2>What the agent can read</h2>
  <p class="secondary">This project, and any folders you add here. Nothing else on this machine.</p>
  <ul class="list">
    <li>
      <span class="item">
        <span class="icon icon-folder" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= it.project.name %></span>
          <span class="muted"><%= it.project.path %></span>
        </span>
      </span>
    </li>
  </ul>
</div>
