<%/* Sample content for the modal: a question, answered in words. Not now
     empties the region, as the shell's Close does. */%>
<div class="stack gap-3">
  <h2>Push <%= it.designs[0]?.title ?? 'this design' %>?</h2>
  <p class="secondary">This pushes <code>prelude/<%= it.designs[0]?.id ?? 'sign-up' %></code> to <code>origin</code>, where others can see it, and opens a pull request for it.</p>
  <div class="cluster actions">
    <button class="btn primary" type="button">Push and open the pull request</button>
    <button class="btn ghost" type="button" command="--koda-empty" commandfor="modal">Not now</button>
  </div>
</div>
