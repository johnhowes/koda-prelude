<%/* A page that fills the window, in the app layout: placeholders for a
     design's page (a heading, then the chat beside the design surface). The
     page marks itself .fills and the shell fills the window with it, so it
     swaps in from any other page as a fragment; there's no layout of its own. */%>
<div class="stack gap-3 gallery-fill fills" aria-hidden="true">
  <div class="stack gap-2">
    <span class="skeleton" style="--w: 25%"></span>
    <span class="skeleton title" style="--w: 35%"></span>
  </div>
  <div class="split gallery-fill">
    <span class="skeleton fill side"></span>
    <span class="skeleton fill"></span>
  </div>
</div>
