<%/* The page on show: an iframe on the design's own origin (or the app's, in
     App mode), titled with the page, in the shape of a page. At a size, the
     page is laid out at that width and height and scaled down to fit the
     panel; Fit fills the panel.

     A client is attributes on the page's root (the desktop app's script
     marks it data-desktop), so what only that client shows appears (R-4tw).
     The frame carries them in its name, which stays with the frame as links
     inside it are followed, and the design's origin sets them on each page.
     Prelude can't run the client itself: Pop out and Open in browser still
     open browser windows. `it.src` is the frame's address. */%>
<% const attributes = it.client.attributes ?? {}; %>
<div class="device" ko-as="device" <% if (it.size.width) { %>style="--w: <%= it.size.width %>; --h: <%= it.size.height %>"<% } %>>
  <iframe title="<%= it.cur.title %><%= it.appMode ? ' (the app)' : '' %>" src="<%= it.src %>"<% if (Object.keys(attributes).length) { %> name="prelude-client:<%= JSON.stringify(attributes) %>"<% } %>></iframe>
</div>
<% if (it.size.width) { %>
<script type="koda">
  // At a size the page keeps its own width and height, and is shown scaled
  // down to the box the panel gives it: a measured scale, which no rule can
  // work out from two lengths.
  const { device, onRemove } = koda.scope();
  const observer = new ResizeObserver(([entry]) => {
    device.element.style.setProperty('--scale', String(entry.contentRect.width / <%= Number(it.size.width) %>));
  });
  observer.observe(device.element);
  onRemove(() => observer.disconnect());
</script>
<% } %>
