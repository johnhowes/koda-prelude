<%/* Messages written while the agent works, waiting under the transcript:
     each as the person's bubble, quieter, with Cancel. When the turn ends,
     they go to the agent together, in order, as the next message. `it` is
     the design; `it.queued` the waiting messages. No whitespace outside the
     items, so with none the list is :empty and takes no room. */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; %>
<% for (const waiting of it.queued ?? []) { %><li class="entry user">
  <div class="bubble"><%= waiting.message %></div>
  <span class="cluster gap-2">
    <span class="muted">Sends when the agent finishes<% if (waiting.images) { %> · with <%= waiting.images === 1 ? '1 image' : `${waiting.images} images` %><% } %></span>
    <form action="<%= base %>/queued/<%= waiting.id %>/cancel" method="post" ko-target="queued">
      <button class="link-btn" type="submit" aria-label="Cancel: <%= waiting.message %>">Cancel</button>
    </form>
  </span>
</li><% } %>
