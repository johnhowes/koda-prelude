<%/* The transcript's entries, oldest first; with none yet, what to do. A
     message sent answers with this list, so it's the region's content. */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; const entries = it.entries ?? []; %>
<% if (!entries.length) { %>
<li class="entry empty muted">
  <%= it.sessions.length === 0 ? 'This design has no sessions yet.' : 'A new session.' %>
  The agent starts from the design’s files and its NOTES.md, so tell it what you want to work on.
</li>
<% } %>
<% for (const entry of entries) { %><%~ include('./_entry', { entry, base }) %><% } %>
