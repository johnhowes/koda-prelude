<%/* Where the page on show goes. In the app this is an iframe on the
     design's own origin (or the app's, in App mode), titled with the page;
     the design draws its place, in the shape of a page, so the frame's size
     can be seen. At a size, the frame is that width and height, scaled down
     to fit the panel; Fit fills the panel.

     A client is passed to the frame's page as attributes on its root (the
     desktop app's script marks it data-desktop), so what only that client
     shows appears. Prelude can't run the client itself: Pop out and Open in
     browser still open browser windows in the preview. */%>
<div class="device" <% if (it.size.width) { %>style="--w: <%= it.size.width %>; --h: <%= it.size.height %>"<% } %>
     role="img" aria-label="<%= it.cur.title %><%= it.appMode ? ', from the app' : `, in ${it.state.title}` %>, <%= it.size.width ? `at ${it.size.width} × ${it.size.height}` : 'fitting the panel' %>. Client: <%= it.client.title %>.">
  <div class="stack gap-5 device-page" aria-hidden="true">
    <div class="cluster">
      <span class="skeleton" style="--w: 12%"></span>
      <span class="spacer"></span>
      <span class="skeleton" style="--w: 18%"></span>
    </div>
    <div class="stack gap-2">
      <span class="skeleton" style="--w: 22%"></span>
      <span class="skeleton title" style="--w: 40%"></span>
    </div>
    <div class="grid" style="--min: 12rem">
      <span class="skeleton block"></span>
      <span class="skeleton block"></span>
      <span class="skeleton block"></span>
    </div>
    <div class="stack gap-2">
      <span class="skeleton"></span>
      <span class="skeleton" style="--w: 85%"></span>
      <span class="skeleton" style="--w: 60%"></span>
    </div>
  </div>
</div>
