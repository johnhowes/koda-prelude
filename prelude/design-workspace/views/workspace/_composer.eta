<%/* The message box. In a session it answers with itself (cleared, or with
     the refusal); for a new session the answer is the new session's page.

     Images go with the message: Attach an image, or paste one into the box,
     or drop one on it. Each uploads as soon as it's added, into the
     session's draft, and comes back as a thumbnail in the tray above the
     box, so the person sees what the agent will see before sending. Sending
     posts the tray's ids with the message; the agent is told where each
     image is, and reads it.

     A refused message comes back with only what was posted, so the form
     carries its own action: the design's fake POST routes need it, where
     the app re-renders from the session it already has. */%>
<% const design = it.folder ? `/f/${it.folder.id}/d/${it.id}` : '';
   const action = it.action || (it.session ? `${design}/sessions/${it.session.id}/messages` : `${design}/sessions`);
   const inSession = action.endsWith('/messages'); const error = it.$errors?.message;
   const draft = it.draft ?? { base: action.replace(/\/sessions(\/[^/]+\/messages)?$/, ''), attachments: [] }; %>
<form class="composer" action="<%= action %>" method="post" ko-item
      <% if (inSession) { %>id="composer" ko-region ko-target="self" ko-attach="replace"<% } %>>
  <input type="hidden" name="type" value="user">
  <input type="hidden" name="action" value="<%= action %>">
  <ul class="attachments" ko-as="attachments" ko-region aria-label="Images to send"><%~ include('./_attachments', draft) %></ul>
  <label class="sr-only" for="message">Message</label>
  <textarea id="message" name="message" ko-as="message" rows="3" required
            placeholder="Describe what to design, or paste a sketch or a screenshot. Enter to send, Shift+Enter for a new line."
            <% if (error) { %>ko-invalid-server="<%= error %>" aria-describedby="message-error"<% } %>><%= it.message ?? '' %></textarea>
  <div class="composer-foot">
    <div class="composer-tools">
      <%/* Uploads on its own, into the tray: a part of the form with its
           own action, so the message isn't sent with it. */%>
      <div ko-form="<%= draft.base %>/attachments" ko-method="post" ko-invoke="change" ko-target="attachments">
        <label class="icon-btn small" title="Attach an image. You can also paste one, or drop it on the box.">
          <span class="icon icon-attach" aria-hidden="true"></span><span class="sr-only">Attach an image</span>
          <input class="sr-only" type="file" name="image" ko-as="upload" accept="image/png, image/jpeg, image/gif, image/webp" multiple>
        </label>
      </div>
      <% if (error) { %><span class="error" id="message-error"><%= error %></span><% } %>
    </div>
    <button class="btn small primary" type="submit">Send</button>
  </div>
  <script type="koda">
    // Two things no binding or trigger expresses: Enter to send, and taking
    // an image the person pastes or drops, which means moving a File into
    // the upload's input (it then uploads as if chosen there).
    const { message, upload } = koda.scope();
    const form = message.element.form;
    message.element.addEventListener('keydown', event => {
      if (event.key === 'Enter' && !event.shiftKey && !event.isComposing) {
        event.preventDefault();
        form.requestSubmit();
      }
    });
    const take = files => {
      const images = [...files].filter(file => file.type.startsWith('image/'));
      if (!images.length) return false;
      const moved = new DataTransfer();
      for (const image of images) moved.items.add(image);
      upload.element.files = moved.files;
      upload.element.dispatchEvent(new Event('change', { bubbles: true }));
      return true;
    };
    const carriesFiles = event => [...(event.dataTransfer?.types ?? [])].includes('Files');
    message.element.addEventListener('paste', event => { if (take(event.clipboardData?.files ?? [])) event.preventDefault(); });
    form.addEventListener('dragover', event => { if (!carriesFiles(event)) return; event.preventDefault(); form.dataset.dropping = ''; });
    form.addEventListener('dragleave', event => { if (!form.contains(event.relatedTarget)) delete form.dataset.dropping; });
    form.addEventListener('drop', event => { delete form.dataset.dropping; if (carriesFiles(event) && take(event.dataTransfer.files)) event.preventDefault(); });
  </script>
</form>
