<%/* The images going with the next message, as thumbnails: the composer's
     tray, and the answer to adding or removing one. `it` is the session's
     draft; each attachment has id, name and url (the image as uploaded,
     kept with the session so the agent can read it). The thumbnail opens
     the image full size, in the modal. Each posts its id
     with the message, and has Remove. No whitespace outside the items, so
     an empty tray is :empty and takes no room. */%>
<% const base = it.base ?? ''; %>
<% for (const image of it.attachments ?? []) { %><li class="attachment">
  <% if (image.url) { %><a href="<%= base %>/images/<%= image.id %>" ko-target="modal?" title="Show it full size"><img class="thumb" src="<%= image.url %>" alt="Show <%= image.name %> full size"></a><% } else { %><span class="thumb" aria-hidden="true"></span><% } %>
  <span class="attachment-name" title="<%= image.name %>"><%= image.name %></span>
  <input type="hidden" name="attachments" value="<%= image.id %>">
  <button class="icon-btn small" type="submit" formaction="<%= base %>/attachments/<%= image.id %>/remove" formnovalidate ko-target="attachments" aria-label="Remove <%= image.name %>"><span class="icon icon-close" aria-hidden="true"></span></button>
</li><% } %>
