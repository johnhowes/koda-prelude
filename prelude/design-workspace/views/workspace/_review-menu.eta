<%/* The pages the check named, as a menu: each puts its page, in its state,
     in the frame. The one on show is current, so going through them shows
     where you are. `it.pages` have path, title, state, stateTitle and,
     for one that doesn't render, error. */%>
<details class="menu">
  <summary class="btn small"><%= it.label %></summary>
  <div class="menu-list">
    <% for (const page of it.pages) { %>
    <form action="<%= it.base %>/screen" method="post" ko-target="design">
      <%~ it.keep %>
      <input type="hidden" name="surface.state" value="<%= page.state %>">
      <button type="submit" name="surface.current" value="<%= page.path %>" <% if (page.path === it.cur?.id && page.state === it.state?.id) { %>aria-current="true"<% } %>>
        <span class="item-title"><%= page.title %> · <%= page.stateTitle %></span>
        <span class="muted"><%= page.path %><% if (page.error) { %>: <%= page.error %><% } %></span>
      </button>
    </form>
    <% } %>
  </div>
</details>
