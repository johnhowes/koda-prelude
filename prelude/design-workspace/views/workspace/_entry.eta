<%/* One transcript entry. Renders nothing for entries that show nothing
     (a tool's successful result, a turn that ended normally). A page the
     check names - one that doesn't render, or differs from its approved
     screen - has Show beside it, which puts that page, in that state, in
     the design surface. */%>
<% const e = it.entry; %>
<% const show = page => include('./_show', { base: it.base, page }); %>
<% if (e.type === 'user') { %>
<%/* The person's message: its images above the bubble, each opening full
     size; under it, what they were looking at when they sent it, as the
     agent was told. */%>
<li class="entry user">
  <div class="stack gap-1 sent">
    <% if (e.images?.length) { %>
    <ul class="attachments" aria-label="Images">
      <% for (const image of e.images) { %><li><a class="attachment" href="<%= it.base %>/images/<%= image.id %>" ko-target="modal?" title="Show it full size"><img class="thumb" src="<%= image.url %>" alt="Show <%= image.name %> full size"><span class="attachment-name"><%= image.name %></span></a></li><% } %>
    </ul>
    <% } %>
    <% if (e.message) { %><div class="bubble"><%= e.message %></div><% } %>
    <% if (typeof e.lookingAt === 'string') { %><span class="muted looked-at"><span class="icon icon-screen" aria-hidden="true"></span> <%= e.lookingAt %></span><% } %>
  </div>
</li>
<% } else if (e.type === 'text') { %>
<li class="entry agent"><div class="prose"><%~ e.html %></div></li>
<% } else if (e.type === 'tool') { %>
<li class="entry tool"><span class="tool-name"><%= e.name %></span> <span class="tool-summary"><%= e.summary %></span></li>
<% } else if (e.type === 'tool-result' && e.error) { %>
<li class="entry tool failed">
  <details><summary><%= e.name ?? 'Tool' %> was refused or failed</summary><pre><%= e.text %></pre></details>
</li>
<% } else if (e.type === 'check' && e.failures.length) { %>
<li class="entry note failed">
  <details open><summary><%= e.failures.length === 1 ? '1 page doesn’t' : `${e.failures.length} pages don’t` %> render. The agent is told with your next message.</summary>
  <ul class="check-list"><% for (const f of e.failures) { %><li><code><%= f.path %></code><% if (f.stateTitle) { %> · <%= f.stateTitle %><% } %>: <%= f.error %> <%~ show(f) %></li><% } %></ul></details>
</li>
<% } else if (e.type === 'check') { %>
<li class="entry note">Prelude rendered every page and form in every state<%= e.rendered ? ` (${e.rendered})` : '' %>, and they all render.</li>
<% } else if (e.type === 'note') { %>
<li class="entry note<%= e.failed ? ' failed' : '' %>"><%= e.text %></li>
<% } else if (e.type === 'turn' && e.stopped) { %>
<li class="entry note">Stopped.</li>
<% } else if (e.type === 'turn' && !e.ok) { %>
<li class="entry note failed"><%= e.error ?? 'The agent stopped with an error.' %></li>
<% } %>
<% if (e.type === 'check' && e.warnings?.length) { %>
<li class="entry note failed">
  <details open><summary><%= e.warnings.length === 1 ? '1 rule points' : `${e.warnings.length} rules point` %> at nothing in the design. The agent is told with your next message.</summary>
  <ul class="check-list"><% for (const warning of e.warnings) { %><li><%= warning %></li><% } %></ul></details>
</li>
<% } %>
<% if (e.type === 'check' && e.differ?.length) { %>
<li class="entry note">
  <details open><summary><%= e.differ.length === 1 ? '1 page differs' : `${e.differ.length} pages differ` %> from the approved screens. If that’s what you asked for, approve them again in the design bar.</summary>
  <ul class="check-list"><% for (const d of e.differ) { %><li><code><%= d.path %></code> · <%= d.stateTitle %> <%~ show(d) %></li><% } %></ul></details>
</li>
<% } %>
