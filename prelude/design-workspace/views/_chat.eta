<%/* The chat: a panel whose toolbar holds what belongs to the conversation
     (which session, whether to show the agent's tool calls), then the
     transcript, the status line and the message box. A build session says so
     at the top, with the way back to Build. A new conversation about the
     project (a fix with no sessions yet) has no sessions to list or to add to.

     There's no New session: opening a design starts one when the last is
     finished, and nothing else needed it. On a new session's page the
     sessions menu is titled so, with no item current.

     The agent's words always show. Its tool calls are hidden unless Tools is
     on: a preference of the person's, remembered in this browser
     (ko-persist), not the design's (R-t7w). */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; const fresh = it.kind === 'fix' && !it.sessions.length; %>
<section class="panel side chat" aria-label="Session">
  <div class="toolbar">
    <% if (it.sessions.length > 0) { %>
    <details class="menu start sessions-menu">
      <summary class="btn small ghost"><span class="icon icon-session" aria-hidden="true"></span><span class="clip"><%= it.session ? it.session.title : 'New session' %></span></summary>
      <ul class="menu-list">
        <% for (const s of it.sessions) { %>
        <li><a href="<%= base %>/sessions/<%= s.id %>" <% if (it.session && s.id === it.session.id) { %>aria-current="page"<% } %>>
          <span class="item-title"><%= s.title %><% if (s.build) { %> <span class="pill">Build</span><% } %></span>
          <span class="muted"><%= s.started %></span>
        </a></li>
        <% } %>
      </ul>
    </details>
    <% } else if (fresh) { %>
    <span class="muted">A new conversation</span>
    <% } else { %>
    <span class="muted">No sessions yet</span>
    <% } %>
    <span class="spacer"></span>
    <label class="choice" title="Show each file the agent reads, searches or edits, between its messages."><input type="checkbox" class="show-tools" ko-persist="chat.showTools" ko-persist-in="local"> Tools</label>
    <%/* What the agent is waiting on the person to decide: counted in the
         accent, since each is a next step. */%>
    <% if (it.questions?.length) { %>
    <a class="btn small ghost" href="<%= base %>/questions" ko-target="drawer?" title="Open questions: what the agent is waiting for you to decide."><span class="icon icon-question" aria-hidden="true"></span>Questions <span class="pill accent"><%= it.questions.length %></span></a>
    <% } %>
  </div>
  <% if (it.session?.build) { %>
  <div class="notice" role="note">
    <p>This session builds <strong><%= it.session.build.title %></strong> into the app, on this design’s branch. <% if (it.buildUrl) { %><a href="<%= it.buildUrl %>">Back to Build</a><% } %></p>
  </div>
  <% } %>

  <%/* The scroller is a reversed column, so it starts at the bottom and stays
       there as entries arrive - unless the person has scrolled up to read. */%>
  <div class="transcript-scroll">
    <ol id="transcript" class="transcript" ko-region aria-live="polite"><%~ include('./_transcript', it) %></ol>
  </div>

  <%/* Waiting to send, while the agent works. */%>
  <ol id="queued" class="transcript queued" ko-region aria-label="Waiting to send"><%~ include('./_queued', it) %></ol>

  <div id="agent-status" ko-region><%~ include('./_status', it.state) %></div>

  <%~ include('./_composer', it) %>
</section>
