<%/* The page menu, in the design bar: which page is on show, and the way to
     the others. The design's titled pages in order, each overlay under its
     page; a page about one record shows the state's first, and others are
     reached by following links in the page itself. Refresh and Open in
     browser act on the page on show, so they end the menu.

     `it` has screens, cur (the screen on show), current (its path), base,
     keep, url and origin. */%>
<div class="menu start">
  <button class="btn small ghost" type="button" popovertarget ko-for="pageMenu"><span class="icon icon-screen" aria-hidden="true"></span><span class="clip"><%= it.cur.title %></span></button>
  <div class="menu-list" ko-as="pageMenu" popover>
    <form action="<%= it.base %>/screen" method="post" ko-target="design">
      <%~ it.keep %>
      <% for (const screen of it.screens) { %>
      <button type="submit" name="surface.current" value="<%= screen.id %>" <% if (screen === it.cur) { %>aria-current="true"<% } %>>
        <span class="item-title"><%= screen.title %></span>
        <span class="muted"><%= screen.id %><% if (screen.ported) { %> · the app’s own view<% } %></span>
      </button>
      <% } %>
    </form>
    <hr>
    <a href="<%= it.url %>" ko-target="design"><span class="item-title">Refresh</span><span class="muted">Load this page again</span></a>
    <a href="<%= it.origin %><%= it.current %>" target="_blank"><span class="item-title">Open in browser</span><span class="muted"><%= it.origin %><%= it.current %></span></a>
  </div>
</div>
