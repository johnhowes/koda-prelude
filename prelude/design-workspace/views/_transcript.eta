<%/* The transcript's entries, oldest first; with none yet, where to start. A
     message sent answers with this list, so it's the region's content. What
     the agent is writing now, if anything, ends it (`it.streaming`), so a
     reload or a message sent mid-sentence finds it in place. */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; const entries = it.entries ?? []; %>
<% if (!entries.length) { %><%~ include('./_starters', it) %><% } %>
<% for (const entry of entries) { %><%~ include('./_entry', { entry, base }) %><% } %>
<% if (it.streaming) { %><%~ include('./_live-entry', it.streaming) %><% } %>
