<%/* The page's header, one line: where the design sits, its title, and its
     branch in a word or two, which opens the drawer with the rest. A pill
     says only what the person should act on or know at a glance: the check,
     and how far behind main the branch is.

     A conversation about the project (a fix, step 11) starts with no branch:
     the agent only reads (R-h7w), so the header says so, and offers Fix it on a
     branch, which asks first in the modal. A new one (no sessions yet) has
     nothing to fix or rename. Its title comes from its first message (R-m5c), and
     Rename changes it, on a branch or not (R-j3v). */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; const w = it.branch;
   const reading = it.kind === 'fix' && !w && !it.merged; const fresh = reading && !it.sessions.length; %>
<header class="cluster gap-3 design-head">
  <div class="stack gap-0">
    <nav class="crumbs" aria-label="Where you are">
      <a href="/">Projects</a><span aria-hidden="true">›</span>
      <a href="/f/<%= it.folder.parentId ?? it.folder.id %>"><%= it.folder.name %></a>
      <% if (it.area) { %><span aria-hidden="true">›</span><span><%= it.area %></span><% } %>
    </nav>
    <div class="cluster gap-2">
      <h1><%= it.title %></h1>
      <% if (it.kind === 'fix' && !fresh) { %><a class="icon-btn small" href="<%= base %>/rename" ko-target="modal?" title="Rename it"><span class="icon icon-rename" aria-hidden="true"></span><span class="sr-only">Rename <%= it.title %></span></a><% } %>
    </div>
    <%/* Where the design stands, and the one next step (10.9). */%>
    <%/* A fix (step 11): the designs it has changed, each to look at and approve there. */%>
    <% if (it.changes?.length) { %><p class="stage secondary">Changes <% it.changes.forEach((d, i) => { %><%= i ? ', ' : '' %><a href="<%= d.url %>"><%= d.title %></a><% }) %></p><% } %>
    <% if (reading) { %><p class="stage secondary"><strong>Reading only</strong> · <%= fresh ? 'Ask about this project, or say what’s wrong. The agent reads the designs and the app to answer, and changes nothing until you fix it on a branch.' : 'The agent answers from the project and changes nothing. If something needs fixing, fix it on a branch.' %></p><% } %>
    <% if (it.stage && !(it.merged && !it.branch)) { %><p class="stage secondary"><strong><%= it.stage.label %></strong> · <%= it.stage.next %></p><% } %>
  </div>
  <span class="spacer"></span>
  <div class="cluster">
    <% if (reading) { %>
    <% if (!fresh) { %><a class="btn small" href="<%= base %>/branch" ko-target="modal?" title="Make a branch for this, and let the agent change the project there."><span class="icon icon-push" aria-hidden="true"></span>Fix it on a branch…</a><% } %>
    <% } else { %>
    <a class="btn small ghost branch-summary" href="<%= base %>/about" ko-target="drawer?" title="The branch, what this design uses, and what the agent can read.">
      <% if (w) { %>
      <span class="icon icon-push" aria-hidden="true"></span><code><%= w.branch %></code>
      <% if (w.merging?.unresolved?.length) { %><span class="pill danger">Clash to resolve</span>
      <% } else if (w.check === 'failing') { %><span class="pill danger"><%= w.failures === 1 ? '1 page doesn’t render' : `${w.failures} pages don’t render` %></span>
      <% } else if (w.check === 'waiting') { %><span class="pill warn">Host needs approval</span>
      <% } else if (w.check === 'passing') { %><span class="pill good">Check passes</span>
      <% } else if (it.kind !== 'fix') { %><span class="pill">Not checked yet</span><% } %>
      <% if (w.behind) { %><span class="pill warn"><%= w.behind %> behind <%= w.into %></span><% } %>
      <% } else if (it.merged) { %>
      <span class="icon icon-done" aria-hidden="true"></span>Merged into <%= it.merged.into %>
      <% } else { %>
      <span class="icon icon-document" aria-hidden="true"></span>About the design
      <% } %>
    </a>
    <% } %>
    <% if (it.buildUrl) { %><a class="btn small" href="<%= it.buildUrl %>"><span class="icon icon-code" aria-hidden="true"></span>Build</a><% } %>
  </div>
</header>
