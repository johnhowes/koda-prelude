                      ] },
                      { "title": "Shared helpers", "parts": [
                        { "id": "money", "title": "Money", "url": "/f/borrower-portal/architecture/parts/money", "summary": "Amounts, rounding and formatting" }
                      ] },
                      { "title": "Outside", "parts": [
                        { "id": "lender-api", "title": "Lender API", "url": "/f/borrower-portal/architecture/parts/lender-api", "summary": "Offers from partner lenders", "outside": true },
