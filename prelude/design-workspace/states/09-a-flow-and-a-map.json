                        { "id": "notifications", "title": "Notifications", "url": "/f/borrower-portal/architecture/parts/notifications", "summary": "Emails and texts to borrowers" }
                      ] },
                      { "title": "Data", "parts": [
                        { "id": "offer-store", "title": "Offer store", "url": "/f/borrower-portal/architecture/parts/offer-store", "summary": "Offers and their terms, in Postgres" },
