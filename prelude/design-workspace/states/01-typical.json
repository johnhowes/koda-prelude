          "entries": [
            { "id": 1, "type": "user", "message": "Let’s show each offer’s monthly payment beside its rate, and let the borrower compare two offers side by side.", "lookingAt": "Offers · Typical" },
            { "id": 2, "type": "text", "html": "<p>I’ll add the monthly payment to each offer’s row, and a <strong>Compare offers</strong> page that takes two offers.</p>" },
            { "id": 3, "type": "tool", "name": "Read", "summary": "prelude/loan-offers/NOTES.md" },
            { "id": 4, "type": "tool", "name": "Write", "summary": "prelude/loan-offers/views/offers/_row.eta" },
            { "id": 5, "type": "tool", "name": "Write", "summary": "prelude/loan-offers/views/offers/compare.eta" },
            { "id": 6, "type": "tool", "name": "Edit", "summary": "prelude/loan-offers/routes.json" },
            { "id": 7, "type": "tool", "name": "Edit", "summary": "prelude/loan-offers/states/01-typical.json" },
            { "id": 8, "type": "text", "html": "<p>Each row now shows the monthly payment under the APR, and <code>/offers/compare</code> puts two offers side by side, with the total cost of each. With no offers, Compare isn’t offered.</p><p>Should the comparison also show what each costs over its whole term, or only per month?</p>" },
            { "id": 9, "type": "check", "rendered": 18, "failures": [], "differ": [], "warnings": [] },
            { "id": 10, "type": "note", "text": "Committed to prelude/loan-offers (4e1a9c2)." },
            { "id": 11, "type": "user", "message": "Over the whole term too. And make the cheaper offer stand out.", "lookingAt": "Compare offers · Typical · Phone" },
            { "id": 12, "type": "tool", "name": "Edit", "summary": "prelude/loan-offers/views/offers/compare.eta" },
            { "id": 13, "type": "tool", "name": "Edit", "summary": "prelude/loan-offers/NOTES.md" },
            { "id": 14, "type": "text", "html": "<p>The comparison now shows the total cost over each term, and the cheaper offer carries a <em>Lower total cost</em> pill. I kept the accent for the Accept button, as the system asks.</p>" },
            { "id": 15, "type": "check", "rendered": 18, "failures": [], "differ": [], "warnings": [] },
            { "id": 16, "type": "note", "text": "Committed to prelude/loan-offers (b71d03e)." }
          ],
          "rules": [
            { "id": "R-v4p", "text": "Offers are listed lowest APR first; offers with the same APR, shorter term first.", "status": "built", "shownOn": { "page": "/offers", "title": "Offers", "state": "01-typical", "stateTitle": "Typical" } },
            { "id": "R-q8m", "text": "An expired offer can’t be accepted: in place of Accept, it says when it expired.", "status": "built", "shownOn": { "page": "/offers/off-2291", "title": "Offer", "state": "03-expired", "stateTitle": "An offer expired" } },
            { "id": "R-k3f", "text": "Of two offers compared, the one that costs less over its whole term is marked “Lower total cost”; when they cost the same, neither is.", "status": "proposed", "shownOn": { "page": "/offers/compare", "title": "Compare offers", "state": "01-typical", "stateTitle": "Typical" } },
            { "id": "R-c9h", "text": "An offer’s total cost includes every fee the lender charges, not only interest.", "status": "proposed", "shownOn": { "page": "/offers/compare", "title": "Compare offers", "state": "04-long-names", "stateTitle": "Long names" } },
            { "id": "R-7dn", "text": "Accepting an offer emails the borrower a copy of its terms.", "status": "proposed", "shownOn": null },
            { "id": "R-2wd", "text": "Offers are listed newest first.", "status": "retired", "shownOn": null, "retired": "listed by rate instead, so the cheapest is first (15 Oct)." }
