<%/* A design's branch (step 9), wherever it's listed: what it's doing, where
     its check stands, how it stands against main, what it changes outside
     its design, and its actions - bring main in, and finish (merge here, or
     push for a pull request when there's a remote). `it.work` is
     branchState()'s; `it.finish` the folder's /branches/<id> URL; `it.back`
     where to come back to; `it.error` why finishing it just failed. */%>
<% const w = it.work; %>
<div class="branch">
  <p class="muted">
    On <code><%= w.branch %></code>
    <% if (w.building) { %>· building <%= w.building.title %><% } %>
    · <% if (w.check === 'passing') { %>its check passes
    <% } else if (w.check === 'failing') { %><%= w.failures === 1 ? '1 page doesn’t' : `${w.failures} pages don’t` %> render yet
    <% } else if (w.check === 'waiting') { %>its design host needs your approval
    <% } else { %>not checked yet<% } %>
    <% if (w.behind) { %>· <%= w.behind %> <%= w.behind === 1 ? 'commit' : 'commits' %> behind <%= w.into %><% } %>
    <% if (!w.worked) { %>· nothing done on it yet<% } %>
  </p>
  <%/* The app on this branch (10.7): its design host is the app itself, with
       its own data. One url serves one branch at a time, so another branch
       may have it; Start it takes it back. Open goes through Prelude's own
       origin, so the desktop app opens it in the system browser. */%>
  <% if (w.running?.running) { %>
  <p class="muted">The app on this branch, with its own data, is running at <code><%= w.running.url %></code> · <a href="<%= w.running.open %>" target="_blank">Open<span class="icon icon-external" aria-hidden="true"></span></a></p>
  <% } else if (w.running && w.running.approved) { %>
  <form class="app-line" action="<%= w.running.start %>" method="post">
    <input type="hidden" name="back" value="<%= it.back %>">
    <span class="muted">The app on this branch isn’t running.</span>
    <button class="btn small ghost" type="submit" title="Start the app from this branch at <%= w.running.url %>. If another branch’s app is running there, it stops.">Start it</button>
  </form>
  <% } else if (w.running) { %>
  <p class="muted">The app on this branch isn’t running: its design host needs your approval first, in the design bar.</p>
  <% } %>
  <% if (w.alsoChanges.length) { %>
  <p class="muted">Also changes, outside the design: <% for (const [i, path] of w.alsoChanges.slice(0, 6).entries()) { %><%= i ? ', ' : '' %><code><%= path %></code><% } %><%= w.alsoChanges.length > 6 ? `, and ${w.alsoChanges.length - 6} more` : '' %></p>
  <% } %>
  <% if (it.error) { %><p class="err" role="alert"><%= it.error %></p><% } %>
  <div class="rowbtns">
    <% if (w.behind) { %>
    <form action="<%= it.finish %>/update" method="post">
      <input type="hidden" name="back" value="<%= it.back %>">
      <button class="btn small" type="submit" title="Merge <%= w.into %> into this branch, so it carries on from what’s there now.">Update from <%= w.into %></button>
    </form>
    <% } %>
    <% if (w.worked) { %>
    <form action="<%= it.finish %>/<%= w.remote ? 'publish' : 'merge' %>" method="post">
      <input type="hidden" name="back" value="<%= it.back %>">
      <button class="btn small<%= w.check === 'passing' ? ' primary' : '' %>" type="submit"
              title="<%= w.remote ? `Push ${w.branch} and open a pull request into ${w.into}. Prelude asks first.` : `Merge ${w.branch} into ${w.into}: the design and anything built, together. Its worktree and branch are tidied up after.` %>"><%= w.remote ? 'Push and open a pull request' : `Merge into ${w.into}` %></button>
    </form>
    <% } %>
  </div>
</div>
