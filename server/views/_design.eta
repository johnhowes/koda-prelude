<%/* The design surface: one screen of the design in a frame, with a picker,
     Refresh, Open in browser and Pop out. It is a region that answers with
     itself, and reloads itself whenever the server says the design changed -
     its files, the screen on show, or a pop-out window opening or closing - so
     every window showing it stays in step with no script.

     `view` is 'inline' (beside the chat) or 'window' (a pop-out). While a
     window is open, the inline surface shrinks to a strip.

     A hosted design (views, routes.json, states/) offers its titled pages as
     the screens and its fake datasets as states; the frame is on the design's
     own origin. `frame` and `open` are worked out by the server. */%>
<% const cur = it.current; const surfaceUrl = mode => `${it.base}/preview?view=${it.view}${mode === 'app' ? '&mode=app' : ''}`; const url = surfaceUrl(it.mode); const appMode = it.mode === 'app'; %>
<div id="design" class="design <%= it.popped ? 'popped' : '' %>" ko-source="<%= url %>" ko-location="<%= url %>" ko-attach="replace" ko-invoke="event:design-changed">
  <div class="design-bar">
    <%/* Design or App (10.8): the same screen, from the design's views and
         states, or from the app built here, with its own data. The mode is
         in the surface's URL, so each window keeps its own. */%>
    <% if (it.app) { %>
    <span class="mode-switch" role="group" aria-label="Show">
      <a class="btn small ghost" href="<%= surfaceUrl('design') %>" ko-target="design" <% if (!appMode) { %>aria-current="true"<% } %> title="The design’s views, with its states.">Design</a>
      <a class="btn small ghost" href="<%= surfaceUrl('app') %>" ko-target="design" <% if (appMode) { %>aria-current="true"<% } %> title="The app built on this branch, at <%= it.app.url %>, with its own data.">App</a>
    </span>
    <% } %>
    <% if (it.screens.length > 0) { %>
    <details class="menu screens-menu">
      <summary class="btn small ghost"><span class="icon icon-screen" aria-hidden="true"></span><%= cur.title %></summary>
      <form class="menu-list" action="<%= it.base %>/screen" method="post" ko-target="design">
        <input type="hidden" name="view" value="<%= it.view %>"><input type="hidden" name="mode" value="<%= it.mode %>">
        <% for (const screen of it.screens) { %>
        <button type="submit" name="screen" value="<%= screen.id %>" <% if (screen.id === cur.id) { %>aria-current="true"<% } %>>
          <span class="item-title"><%= screen.title %></span>
          <span class="muted"><%= screen.file %><% if (screen.ported) { %> · the app’s own view<% } %></span>
        </button>
        <% } %>
      </form>
    </details>
    <% } %>
    <% if (appMode) { %>
    <span class="muted">The app, with its own data</span>
    <% } else { %>
    <% if (it.states.length > 1) { %>
    <details class="menu screens-menu">
      <summary class="btn small ghost">State: <%= it.state.title %></summary>
      <form class="menu-list" action="<%= it.base %>/state" method="post" ko-target="design">
        <input type="hidden" name="view" value="<%= it.view %>"><input type="hidden" name="mode" value="<%= it.mode %>">
        <% for (const state of it.states) { %>
        <button type="submit" name="state" value="<%= state.id %>" <% if (state.id === it.state.id) { %>aria-current="true"<% } %>>
          <span class="item-title"><%= state.title %></span>
          <span class="muted"><%= state.file %></span>
        </button>
        <% } %>
      </form>
    </details>
    <% } %>
    <%/* Server events (6e): the server speaks first, down the design's live
         channel. The answer lands in the status beside it, never on the
         frame, so the page shows the event arrive. */%>
    <% if (it.events?.length) { %>
    <details class="menu screens-menu">
      <summary class="btn small ghost">Send event</summary>
      <form class="menu-list" action="<%= it.base %>/events" method="post" ko-target="event-status">
        <% for (const event of it.events) { %>
        <button type="submit" name="event" value="<%= event.name %>">
          <span class="item-title"><%= event.title %></span>
          <span class="muted"><%= event.name %></span>
        </button>
        <% } %>
      </form>
    </details>
    <span id="event-status" ko-region role="status"></span>
    <% } %>
    <% if (it.changed) { %>
    <form action="<%= it.base %>/reset" method="post" ko-target="design">
      <input type="hidden" name="view" value="<%= it.view %>"><input type="hidden" name="mode" value="<%= it.mode %>">
      <button class="btn small ghost" type="submit" title="Forms have changed this state's data. Start again from its file.">Reset data</button>
    </form>
    <% } %>
    <span class="muted"><%= it.screens.length %> <%= it.hosted ? (it.screens.length === 1 ? 'page' : 'pages') : (it.screens.length === 1 ? 'screen' : 'screens') %><% if (it.ported?.count) { %> · <span title="Built pages are the app’s own code (@app/…), rendered from this branch, with each state’s data as their fixtures."><%= it.ported.count === it.ported.of ? 'the app’s own views, with the design’s states' : `${it.ported.count} of ${it.ported.of} routes are the app’s own` %></span><% } %></span>
    <% if (it.hosted && it.screens.length) { %>
    <%/* Saves every page in every state as it renders now; the check, and
         `prelude check` in CI, then fail when one renders differently. */%>
    <form action="<%= it.base %>/approve" method="post" ko-target="design">
      <input type="hidden" name="view" value="<%= it.view %>"><input type="hidden" name="mode" value="<%= it.mode %>">
      <button class="btn small ghost" type="submit" title="Save every page in every state as it renders now. The check then says when one renders differently."><%= it.approved ? 'Approve again' : 'Approve these screens' %></button>
    </form>
    <% } %>
    <% } %>
    <% if (it.notice) { %><span class="muted" role="status"><%= it.notice %></span><% } %>
    <span class="spacer"></span>
    <% if (it.popped) { %>
    <span class="muted">Showing in its own window</span>
    <a class="btn small ghost" href="<%= it.base %>/window" target="<%= it.windowName %>" data-pop-out>Show window</a>
    <% } else if (cur) { %>
    <a class="btn small ghost" href="<%= url %>" ko-target="design">Refresh</a>
    <a class="btn small ghost" href="<%= it.open %>" target="_blank">
      <span class="icon icon-external" aria-hidden="true"></span>Open in browser
    </a>
    <% } %>
    <% if (it.view === 'inline' && !it.popped) { %>
    <%/* A named target: the browser opens one window for this design and
         reuses it, so pressing Pop out again finds the window already open.
         In the desktop app, data-pop-out makes it a real window instead. */%>
    <a class="btn small ghost" href="<%= it.base %>/window" target="<%= it.windowName %>" data-pop-out>
      <span class="icon icon-expand" aria-hidden="true"></span>Pop out
    </a>
    <% } %>
  </div>
  <% if (it.host && !it.host.approved) { %>
  <form class="host-approval" action="<%= it.host.approve %>" method="post">
    <input type="hidden" name="back" value="<%= it.host.back %>">
    <p><strong>This repository has its own design host.</strong> It renders the design’s views with the app’s real components, by running <code><%= it.host.start %></code> here. The views are written by the agent and run as code on this machine, with your permissions, outside Prelude’s sandbox.</p>
    <button class="btn small primary" type="submit">Approve and start it</button>
  </form>
  <% } else if (it.host && it.host.log) { %>
  <details class="host-log"><summary class="muted">Design host log<%= it.host.running ? '' : ' (stopped)' %></summary><pre><%= it.host.log %></pre></details>
  <% } %>
  <% if (!it.popped) { %>
  <div class="design-frame">
    <% if (cur && appMode && !it.app.running) { %>
    <%/* One url serves one branch at a time: the app may be running from another. */%>
    <% if (it.app.approved) { %>
    <form class="design-empty" action="<%= it.app.start %>" method="post" ko-target="design">
      <input type="hidden" name="back" value="<%= url %>">
      <p class="muted">The app on this branch isn’t running.</p>
      <button class="btn small primary" type="submit" title="Start the app from here at <%= it.app.url %>. If another branch’s app is running there, it stops.">Start it</button>
    </form>
    <% } else { %>
    <p class="design-empty muted">The app on this branch isn’t running: its design host needs your approval first, above.</p>
    <% } %>
    <% } else if (cur && appMode) { %>
    <%/* The app itself, on its own origin: its views run unsandboxed, outside Prelude. */%>
    <iframe title="<%= cur.title %> (the app)" src="<%= it.frame %>"></iframe>
    <% } else if (cur) { %>
    <%/* Served from the preview origin, so the screen can't reach Prelude. */%>
    <iframe title="<%= cur.title %>" src="<%= it.frame %><%= it.frame.includes('?') ? '&' : '?' %>v=<%= it.version %>"></iframe>
    <% } else { %>
    <p class="design-empty muted"><%= it.hosted ? 'No pages yet: give a route in routes.json a title, and it appears here.' : 'No screens yet. Ask the agent to design one, and it appears here as it’s written.' %></p>
    <% } %>
  </div>
  <% } %>
</div>
