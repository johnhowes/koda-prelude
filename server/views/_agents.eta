<%/* What the agent is working on: a turn running on a design, in any
     project. One is a link to it; several are a menu. Nothing
     when it's idle. Pushed afresh as <div ko-into="agents">. */%>
<% const running = it.agents ?? []; %>
<% if (running.length === 1) { const turn = running[0]; %><a class="btn small ghost" href="<%= turn.url %>" title="<%= turn.project %>"><span class="pulse" aria-hidden="true"></span><span class="shell-clip">The agent is working on <%= turn.design %></span></a><% } else if (running.length > 1) { %><div class="menu">
  <button class="btn small ghost" type="button" popovertarget ko-for="running"><span class="pulse" aria-hidden="true"></span>The agent is working on <%= running.length %> designs</button>
  <ul class="menu-list" ko-as="running" popover>
    <% for (const turn of running) { %>
    <li><a href="<%= turn.url %>">
      <span class="item-title"><%= turn.design %></span>
      <span class="muted"><%= turn.project %></span>
    </a></li>
    <% } %>
  </ul>
</div><% } %>
