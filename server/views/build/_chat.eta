<%/* The session's chat: the design page's (server/views/_chat.eta), as it is,
     with its transcript, status line and message box; `it.chat` is its
     model. Its "This session builds …" notice goes: the header says so now.

     The design's states have no chat model (they describe the build session,
     not the design page), so for them this is the design's stand-in: its
     toolbar, the transcript, the status line and the message box, only
     enough to see the page whole. `it` is the session (BuildSession,
     server/check.js). */%>
<% if (it.chat) { %><%~ include('../_chat', it.chat) %><% } else { %>
<section class="panel side chat" aria-label="Session">
  <div class="toolbar">
    <span class="muted clip"><%= it.title %></span><span class="pill">Build</span>
    <span class="spacer"></span>
    <label class="choice"><input type="checkbox" class="show-tools" ko-persist="chat.showTools" ko-persist-in="local"> Tools</label>
  </div>
  <div class="transcript-scroll">
    <ol id="transcript" class="transcript" ko-region aria-live="polite"><%~ include('./_transcript', it) %></ol>
  </div>
  <% if (it.status) { %>
  <div class="status" role="status">
    <span class="pulse" aria-hidden="true"></span>
    <span class="status-step"><%= it.status.says %></span>
    <form action="<%= it.url %>/stop" method="post"><input type="hidden" name="status" value=""><button class="btn small ghost" type="submit">Stop</button></form>
  </div>
  <% } %>
  <%~ include('./_composer', it) %>
</section>
<% } %>
