<%/* What the app build, or the shell's layouts build, did. Neither has
     screens of its own to check, so where a page's build shows the check,
     these show: what's next (_next); whether the app starts from this
     branch; for the layouts, each of the shell's layouts, built (the app's
     own file) or not yet; and every file the build changed since the
     session started.

     Prelude starts the app afresh after each of the agent's turns, as a
     page's check does before it renders. "Starts" is that it answered
     Prelude in time, not that every page of it works: Open the app is for
     that. One that doesn't start shows what it printed. It runs again after
     each turn (check-done). A page's build has none: its check is beside
     the chat (_check). `it` is the session (BuildSession, server/check.js). */%>
<% if (it.result) { %>
<% const r = it.result; const start = r.start;
   const says = {
     starts: { pill: 'good', label: 'Starts', line: it.app ? `At ${it.app.url}, from this branch, with its own data` : 'From this branch' },
     fails: { pill: 'danger', label: 'Doesn’t start', line: 'It stopped, or didn’t answer, before it was ready' },
     unapproved: { pill: 'warn', label: 'Waiting for you', line: 'It needs your approval before Prelude runs it' },
     none: { pill: '', label: 'Not started', line: 'There’s no app on this branch for Prelude to start yet' },
     unchecked: { pill: '', label: 'Not started yet', line: 'Prelude starts it when the agent’s turn ends' },
   };
   const s = says[start.status] ?? says.unchecked;
   const hows = [['added', 'Added'], ['changed', 'Changed'], ['removed', 'Removed']];
   const files = r.changes.files; %>
<div class="stack gap-5">
  <%~ include('./_next', it) %>

  <section class="stack gap-1" aria-label="The app">
    <h3 class="group-label">The app</h3>
    <ul class="list">
      <li><span class="item">
        <span class="icon icon-run" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title">Whether it starts<span class="pill <%= s.pill %>"><%= s.label %></span></span>
          <span class="muted"><%= s.line %></span>
        </span>
      </span></li>
    </ul>
    <% if (start.log) { %>
    <details class="disclosure" open>
      <summary>What it printed</summary>
      <pre><%= start.log %></pre>
    </details>
    <% } %>
  </section>

  <% if (r.layouts) { %>
  <section class="stack gap-1" aria-label="The shell’s layouts">
    <h3 class="group-label">The shell’s layouts</h3>
    <ul class="list">
      <% for (const layout of r.layouts) { %>
      <li><span class="item">
        <span class="icon icon-screen" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title">“<%= layout.name %>”<span class="pill <%= layout.file ? 'good' : '' %>"><%= layout.file ? 'Built' : 'Not built yet' %></span></span>
          <span class="muted"><% if (layout.file) { %>The app’s <code><%= layout.file %></code><% } else { %>Still the shell’s own copy<% } %></span>
        </span>
      </span></li>
      <% } %>
    </ul>
  </section>
  <% } %>

  <section class="stack gap-1" aria-label="What the build changed">
    <h3 class="group-label">What the build changed</h3>
    <% if (files.length) { %>
    <% for (const [how, label] of hows) { const these = files.filter(file => file.how === how); if (!these.length) continue; %>
    <details class="disclosure" open>
      <summary><%= label %> (<%= these.length %>)</summary>
      <ul class="list">
        <% for (const file of these) { %>
        <li><span class="item"><span class="icon icon-document" aria-hidden="true"></span><span class="item-text"><code><%= file.path %></code></span></span></li>
        <% } %>
      </ul>
    </details>
    <% } %>
    <% } else { %>
    <p class="muted">Nothing yet.</p>
    <% } %>
    <p class="muted"><%= r.changes.since === 'session' ? 'Every file changed on the branch since this session started, committed or not.' : 'Every file changed on the branch since it began, committed or not: Prelude didn’t note where this session started.' %></p>
  </section>

  <p class="muted" role="status"><%= it.status ? `The agent is working. Prelude starts the app again when its turn ends${r.at ? `; this is from ${r.at}` : ''}.` : r.at ? `Started ${r.at}, after the agent’s last turn.` : 'Prelude starts the app when the agent’s first turn ends.' %></p>
</div>
<% } %>
