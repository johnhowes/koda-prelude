<%/* A design's page: a one-line header (where it is, its title, and its
     branch in a word), then the chat beside the design surface, filling the
     window. Everything else about the design - the branch in full, what it
     uses, what the agent can read - is one click away in the drawer, so the
     header stays one line and the work gets the room. An update from main
     that clashed is the one exception: it holds the branch, so it shows here.

     The page is /f/:folder/d/:design/sessions/:session (the design's URL
     redirects to its latest session, or shows a new one). `it` is the
     design (DesignPage, server/workspace.js). */%>
<% const base = `/f/${it.folder.id}/d/${it.id}`; %>
<div class="stack gap-3 design-page">
  <%~ include('./_header', it) %>
  <% if (it.branch?.merging?.unresolved?.length) { %>
  <% const m = it.branch.merging; %>
  <div class="notice danger" role="alert">
    <strong><%= m.from %> is half brought in.</strong>
    <p><%= m.unresolved.length === 1 ? 'This file clashes' : 'These files clash' %>: <% for (const [i, path] of m.unresolved.entries()) { %><%= i ? ', ' : '' %><code><%= path %></code><% } %>. Send the agent a message and it resolves <%= m.unresolved.length === 1 ? 'it' : 'them' %> first; nothing is committed until it has.</p>
    <div class="cluster actions">
      <form action="/f/<%= it.folder.parentId ?? it.folder.id %>/branches/<%= it.branch.id %>/abandon" method="post">
        <input type="hidden" name="back" value="<%= base %>">
        <button class="btn small ghost" type="submit" title="Call off the update: the branch goes back to how it was before it.">Abandon the update</button>
      </form>
    </div>
  </div>
  <% } %>
  <div class="split gap-3 workspace" style="--side: 26rem">
    <%~ include('./_chat', it) %>
    <%~ include('./_surface', { ...it, view: 'inline' }) %>
  </div>
  <%/* The page's channel (`it.live`, the app's): in the page, not the layout,
       since going to another session swaps only the page, and the channel
       is the session's. */%>
  <% if (it.live) { %><div hidden ko-connect="<%= it.live %>"></div><% } %>
</div>
