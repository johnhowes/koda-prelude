<section class="page folder">
  <p class="crumbs"><a href="/">Projects</a></p>
  <h1><%= it.folder.name %></h1>
  <p class="muted"><%= it.folder.path %></p>

  <% if (it.appError) { %><p class="err card" role="alert"><%= it.appError %></p><% } %>

  <%/* Pushing publishes the branch, so it's asked first (step 9). */%>
  <% if (it.confirmPublish) { %>
  <div class="card" role="alertdialog" aria-labelledby="publish-title">
    <h2 id="publish-title">Push <%= it.confirmPublish.design %>?</h2>
    <p class="sec">This pushes <code><%= it.confirmPublish.branch %></code> to <code><%= it.confirmPublish.remote %></code>, where others can see it, and opens a pull request for it.</p>
    <div class="rowbtns">
      <form action="/f/<%= it.folder.id %>/branches/<%= it.confirmPublish.id %>/publish" method="post">
        <input type="hidden" name="confirm" value="yes">
        <input type="hidden" name="back" value="<%= it.confirmPublish.back %>">
        <button class="btn small primary" type="submit">Push and open the pull request</button>
      </form>
      <a class="btn small ghost" href="<%= it.confirmPublish.back %>">Not now</a>
    </div>
  </div>
  <% } %>
  <% if (it.published) { %>
  <p class="card" role="status">Pushed <code><%= it.published.branch %></code>.
    <% if (it.published.pr) { %>The pull request: <a href="<%= it.published.pr %>" target="_blank"><%= it.published.pr %></a>.
    <% } else if (it.published.compare) { %><a href="<%= it.published.compare %>" target="_blank">Open the pull request</a> on your Git server.
    <% } else { %>Open the pull request on your Git server.<% } %>
    Once it’s merged there, Prelude tidies up the branch here.</p>
  <% } %>

  <%/* In progress (step 10): the current work in one place - each design on
       a branch, its stories, where it stands, and finishing it. Derived from
       the branches; nothing here is stored. */%>
  <% if (it.inProgress.length) { %>
  <div class="card in-progress" ko-item>
    <h2>In progress</h2>
    <ul class="list">
      <% for (const item of it.inProgress) { %>
      <li>
        <a class="item" href="<%= item.work.url %>">
          <span class="icon icon-screen" aria-hidden="true"></span>
          <span class="item-text">
            <span class="item-title"><%= item.design.title %><% if (item.design.kind === 'system') { %><span class="pill">Design system</span><% } else if (item.design.kind === 'shell') { %><span class="pill">App shell</span><% } %></span>
            <span class="muted">prelude/<%= item.design.id %></span>
          </span>
        </a>
        <% if (item.stories.length) { %>
        <ul class="build-routes">
          <% for (const story of item.stories) { %>
          <li><a href="<%= item.buildUrl %>"><%= story.title %></a> <span class="muted">· <%= story.toBuild ? (item.work.building?.title === story.title ? 'building' : 'to build') : 'built' %><%= story.kind === 'changed' ? ' · a change' : story.kind === 'new' ? ' · new' : '' %></span><% if (story.summary) { %><br><span class="muted"><%= story.summary %></span><% } %></li>
          <% } %>
        </ul>
        <% } %>
        <%~ include('./_branch', { work: item.work, finish: `/f/${it.folder.id}/branches/${item.work.id}`, back: `/f/${it.folder.id}`, error: it.finishError?.id === item.work.id ? it.finishError.message : null }) %>
      </li>
      <% } %>
    </ul>
    <% if (it.allStories) { %>
    <details>
      <summary class="btn small ghost">Copy all stories</summary>
      <textarea class="story" ko-as="stories" rows="14" readonly><%= it.allStories %></textarea>
      <button class="btn small" type="button" ko-as="copyAll">Copy</button>
      <script type="koda">
        // Copying to the clipboard is an action on the platform, not a value.
        const { stories, copyAll } = koda.scope();
        copyAll.element.addEventListener('click', async () => {
          await navigator.clipboard.writeText(stories.element.value);
          copyAll.element.textContent = 'Copied';
        });
      </script>
    </details>
    <% } %>
  </div>
  <% } %>

  <div class="card">
    <h2>Designs</h2>
    <% if (it.groups.length === 0 && !it.inProgress.length) { %>
    <p class="sec">No designs yet. A design usually describes one feature, and grows over many sessions. A design system is a design too: its screens are its gallery, and every other design in the project uses it.</p>
    <% } %>
    <% for (const group of it.groups) { %>
    <% if (group.area) { %><h3 class="area"><%= group.area %></h3><% } %>
    <ul class="list">
      <% for (const design of group.designs) { %>
      <li>
        <a class="item" href="<%= design.work ? design.work.url : `/f/${it.folder.id}/d/${design.id}` %>">
          <span class="icon icon-screen" aria-hidden="true"></span>
          <span class="item-text">
            <span class="item-title"><%= design.title %><% if (design.kind === 'system') { %><span class="pill">Design system</span><% } else if (design.kind === 'shell') { %><span class="pill">App shell</span><% } %></span>
            <span class="muted">prelude/<%= design.id %></span>
          </span>
        </a>
        <% if (design.work) { %><%~ include('./_branch', { work: design.work, finish: `/f/${it.folder.id}/branches/${design.work.id}`, back: `/f/${it.folder.id}`, error: it.finishError?.id === design.work.id ? it.finishError.message : null }) %><% } %>
      </li>
      <% } %>
    </ul>
    <% } %>
    <% if (it.merged.length) { %>
    <h3 class="area">Merged lately</h3>
    <ul class="merged-list">
      <% for (const note of it.merged) { %>
      <li class="muted"><code><%= note.branch %></code> was merged into <%= note.into %> on <%= new Date(note.at).toLocaleString() %>; its worktree and branch were tidied up.</li>
      <% } %>
    </ul>
    <% } %>
  </div>

  <%/* The app (step 8): its stack once chosen, and, until it exists, the build
       that creates it on the shell's branch (step 9). Features are built into
       it, so it comes first. Shown too when designs of views exist but no
       stack was recorded (designs made before Prelude asked): starting the
       build settles it. */%>
  <% const designsOfViews = it.groups.some(group => group.designs.some(design => design.kind !== 'system')); %>
  <% if (it.app.stack || it.app.existing || designsOfViews) { %>
  <div class="card" id="app">
    <h2>The app</h2>
    <% if (it.app.built) { %>
    <p class="sec"><%= it.app.stack %><% if (it.app.path) { %>, in <code><%= it.app.path %>/</code><% } %>. Each design’s Build page builds its features into it.</p>
    <% } else if (it.appOnBranch) { %>
    <p class="sec">The app is built on the shell’s branch. Once that branch is in your main branch, features can be built on top of it: open the shell to check what the build made (and approve its design host there, if it asks), then finish the branch.</p>
    <%~ include('./_branch', { work: it.shellWork, finish: `/f/${it.folder.id}/branches/${it.shellWork.id}`, back: `/f/${it.folder.id}#app`, error: it.finishError?.id === it.shellWork.id ? it.finishError.message : null }) %>
    <% } else if (it.shellWork?.building?.group === '@app') { %>
    <p class="sec">The app is being <%= it.app.existing ? 'connected' : 'built' %> on the shell’s branch. <a href="<%= it.shellWork.url %>">Open the shell</a> to follow it.</p>
    <% } else if (it.app.existing) { %>
    <%/* An app the project already has (8b): connected, not built. */%>
    <p class="sec">This project already has an app. Connecting it finds the app and its stack, and points the shell at the app’s own layouts, changing as little as it can, so designs render as the app’s own views and features are built into it.</p>
    <% if (it.canBuild) { %>
    <form action="/f/<%= it.folder.id %>/app/build" method="post">
      <button class="btn small primary" type="submit">Connect the app</button>
      <% if (it.git === 'none') { %><p class="muted">Designs and builds work on git branches: Prelude makes the project’s folder a git repository first, and commits it.</p><% } %>
    </form>
    <% } %>
    <% } else { %>
    <p class="sec">It will be <%= it.app.stack ?? it.defaultStack %>. There’s no app yet: the app build creates it on the shell’s branch, with the shell’s layouts and the design system, so features can be built on top of it.<% if (it.app.custom) { %> Designs here wait for it, since they’re written in its language.<% } %></p>
    <% if (it.canBuild) { %>
    <form action="/f/<%= it.folder.id %>/app/build" method="post">
      <% if (!it.app.stack) { %>
      <details>
        <summary class="muted">Choose another stack</summary>
        <label class="field">
          <span class="f">The app’s stack</span>
          <input name="stack" placeholder="ASP.NET Core MVC with Razor" autocomplete="off">
        </label>
        <p class="muted">The designs here are Eta views; with another stack, the app build also gives the app a design host, and they’re rewritten in its language as they’re built.</p>
      </details>
      <% } %>
      <button class="btn small primary" type="submit">Start the app build</button>
      <button class="btn small ghost" type="submit" name="existing" value="yes" title="Prelude finds the app this project already has and connects it, instead of building one.">This project already has an app</button>
      <% if (it.git === 'none') { %><p class="muted">Designs and builds work on git branches: Prelude makes the project’s folder a git repository first, and commits it.</p><% } %>
    </form>
    <% } else if (it.git === 'inside') { %>
    <p class="muted">This project’s folder is inside another git repository. Open that repository in Prelude to build here, so its builds get branches of their own.</p>
    <% } else if (it.git === 'missing') { %>
    <p class="muted">A build works on a git branch, and git isn’t installed on this machine (or isn’t on the PATH).</p>
    <% } %>
    <% } %>
  </div>
  <% } %>

  <div class="card">
    <h2>New design</h2>
    <form action="/f/<%= it.folder.id %>/designs" method="post">
      <div class="fields">
        <label class="field">
          <span class="f">Title</span>
          <input name="title" value="<%= it.form.title %>" placeholder="Sign up" autocomplete="off"
                 <% if (it.form.errors.title) { %>ko-invalid-server="<%= it.form.errors.title %>"<% } %>>
          <% if (it.form.errors.title) { %><span class="err"><%= it.form.errors.title %></span><% } %>
        </label>
        <label class="field">
          <span class="f">Area <span class="muted">(optional)</span></span>
          <input name="area" value="<%= it.form.area %>" placeholder="onboarding" autocomplete="off" list="areas"
                 <% if (it.form.errors.area) { %>ko-invalid-server="<%= it.form.errors.area %>"<% } %>>
          <% if (it.form.errors.area) { %><span class="err"><%= it.form.errors.area %></span><% } %>
          <datalist id="areas">
            <% for (const group of it.groups) { if (group.area) { %><option value="<%= group.area %>"></option><% } } %>
          </datalist>
        </label>
      </div>
      <%/* Two kinds of design are the folder's, one each: the design system (the
           app's vocabulary) and the shell (its layouts). Each is offered until
           the folder has one. */%>
      <% const kind = it.form.kind ?? 'design'; %>
      <fieldset class="kinds">
        <legend class="sr-only">Kind</legend>
        <label class="check"><input type="radio" name="kind" value="design" <% if (kind === 'design') { %>checked<% } %>> <span>A design <span class="muted">· usually one feature</span></span></label>
        <% if (!it.system) { %>
        <label class="check"><input type="radio" name="kind" value="system" <% if (kind === 'system') { %>checked<% } %>> <span>The project’s design system <span class="muted">· its tokens and components; every other design uses it</span></span></label>
        <% } %>
        <% if (!it.shell) { %>
        <label class="check"><input type="radio" name="kind" value="shell" <% if (kind === 'shell') { %>checked<% } %>> <span>The app’s shell <span class="muted">· its layouts; every other design renders in it</span></span></label>
        <% } %>
      </fieldset>
      <% if (it.system || it.shell) { %>
      <p class="muted">
        <% if (it.system) { %>Designs here use the design system <a href="/f/<%= it.folder.id %>/d/<%= it.system.id %>"><%= it.system.title %></a>.<% } %>
        <% if (it.shell) { %>They render in the shell <a href="/f/<%= it.folder.id %>/d/<%= it.shell.id %>"><%= it.shell.title %></a>.<% } %>
      </p>
      <% } %>
      <% if (it.form.errors.kind) { %><span class="err"><%= it.form.errors.kind %></span><% } %>
      <%/* Asked once, the first time a design is made: the app's stack, which
           its designs are written in. The default is one click; another stack
           is a quiet option (step 8). */%>
      <% if (!it.app.stack && !it.app.existing) { %>
      <div class="stack-choice">
        <p class="muted">Designs are written as the app’s own views. The app will be <strong><%= it.defaultStack %></strong>.</p>
        <details>
          <summary class="muted">Choose another stack</summary>
          <label class="field">
            <span class="f">The app’s stack</span>
            <input name="stack" placeholder="ASP.NET Core MVC with Razor" autocomplete="off">
          </label>
          <p class="muted">Its app is built first, with a design host, and designs are then written in its language. The design system can be designed straight away.</p>
        </details>
        <label class="check"><input type="checkbox" name="existing" value="yes"> <span class="muted">This project already has an app: connect it instead of building one</span></label>
      </div>
      <% } %>
      <div class="rowbtns">
        <button class="btn small primary" type="submit"><span class="icon icon-add" aria-hidden="true"></span>Create design</button>
      </div>
    </form>
  </div>

  <div class="card" id="reading">
    <h2>What the agent can read</h2>
    <p class="sec">The project’s folder, and any folders you add here, such as another repository whose CSS a design system should start from. Nothing else on this machine. The agent writes only inside the design it’s working on.</p>
    <ul class="list">
      <li><span class="item"><span class="icon icon-folder" aria-hidden="true"></span>
        <span class="item-text"><span class="item-title"><%= it.folder.name %></span><span class="muted"><%= it.folder.path %></span></span></span></li>
      <% for (const reference of it.references) { %>
      <li>
        <span class="item">
          <span class="icon icon-folder" aria-hidden="true"></span>
          <span class="item-text"><span class="item-title"><%= reference.name %></span><span class="muted"><%= reference.path %></span></span>
          <span class="spacer"></span>
          <form action="/f/<%= it.folder.id %>/references/remove" method="post">
            <input type="hidden" name="path" value="<%= reference.path %>">
            <button class="btn small ghost" type="submit" aria-label="Stop reading <%= reference.name %>"><span class="icon icon-close" aria-hidden="true"></span></button>
          </form>
        </span>
      </li>
      <% } %>
    </ul>
    <form class="add-reference" action="/f/<%= it.folder.id %>/references" method="post">
      <label class="f" for="reference-path">Add a folder</label>
      <div class="inline">
        <input id="reference-path" name="path" value="<%= it.reference.value %>" placeholder="C:\Projects\another-app" autocomplete="off" spellcheck="false"
               <% if (it.reference.error) { %>ko-invalid-server="<%= it.reference.error %>" aria-describedby="reference-error"<% } %>>
        <button class="btn small" type="button" data-pick-folder data-desktop-only>Choose…</button>
        <button class="btn small" type="submit">Add</button>
      </div>
      <% if (it.reference.error) { %><span class="err" id="reference-error"><%= it.reference.error %></span><% } %>
    </form>
  </div>
</section>
