<section class="page folder">
  <p class="crumbs"><a href="/">Folders</a></p>
  <h1><%= it.folder.name %></h1>
  <p class="muted"><%= it.folder.path %></p>

  <div class="card">
    <h2>Designs</h2>
    <% if (it.groups.length === 0) { %>
    <p class="sec">No designs yet. A design usually describes one feature, and grows over many sessions. A design system is a design too: its screens are its gallery, and every other design in the folder uses it.</p>
    <% } %>
    <% for (const group of it.groups) { %>
    <% if (group.area) { %><h3 class="area"><%= group.area %></h3><% } %>
    <ul class="list">
      <% for (const design of group.designs) { %>
      <li>
        <a class="item" href="/f/<%= it.folder.id %>/d/<%= design.id %>">
          <span class="icon icon-screen" aria-hidden="true"></span>
          <span class="item-text">
            <span class="item-title"><%= design.title %><% if (design.kind === 'system') { %><span class="pill">Design system</span><% } else if (design.kind === 'shell') { %><span class="pill">App shell</span><% } %></span>
            <span class="muted">prelude/<%= design.id %></span>
          </span>
        </a>
      </li>
      <% } %>
    </ul>
    <% } %>
  </div>

  <%/* The app (step 8): its stack once chosen, and, until it exists, the build
       that creates it. Features are built into it, so it comes first. Shown
       too when designs of views exist but no stack was recorded (designs made
       before Prelude asked): starting the build settles it. */%>
  <% const designsOfViews = it.groups.some(group => group.designs.some(design => design.kind !== 'system')); %>
  <% if (it.app.stack || designsOfViews) { %>
  <div class="card" id="app">
    <h2>The app</h2>
    <% if (it.app.built) { %>
    <p class="sec"><%= it.app.stack %><% if (it.app.path) { %>, in <code><%= it.app.path %>/</code><% } %>. Each design’s Build page builds its features into it.</p>
    <% } else { %>
    <p class="sec">It will be <%= it.app.stack ?? it.defaultStack %>. There’s no app yet: the app build creates it on a branch of its own, with the shell’s layouts and the design system, so features can be built on top of it.<% if (it.app.custom) { %> Designs here wait for it, since they’re written in its language.<% } %></p>
    <% if (it.appError) { %><p class="err" role="alert"><%= it.appError %></p><% } %>
    <% if (it.canBuild) { %>
    <form action="/f/<%= it.folder.id %>/app/build" method="post">
      <% if (!it.app.stack) { %>
      <details>
        <summary class="muted">Choose another stack</summary>
        <label class="field">
          <span class="f">The app’s stack</span>
          <input name="stack" placeholder="ASP.NET Core MVC with Razor" autocomplete="off">
        </label>
        <p class="muted">The designs here are Eta views; with another stack, the app build also gives the app a design host, and they’re rewritten in its language as they’re built.</p>
      </details>
      <% } %>
      <button class="btn small primary" type="submit">Start the app build</button>
      <p class="muted">The build works on a git branch. Prelude <%= it.git === 'none' ? 'makes this folder a git repository and commits it' : 'commits prelude/' %> first, so the branch starts from your designs as they are now.</p>
    </form>
    <% } else if (it.git === 'inside') { %>
    <p class="muted">This folder is inside another git repository. Open that repository in Prelude to build here, so its builds get branches of their own.</p>
    <% } else if (it.git === 'missing') { %>
    <p class="muted">A build works on a git branch, and git isn’t installed on this machine (or isn’t on the PATH).</p>
    <% } %>
    <% } %>
    <% if (it.appBuilds.length) { %>
    <ul class="list">
      <% for (const build of it.appBuilds) { %>
      <li><a class="item" href="/f/<%= build.id %>/d/<%= build.design %>">
        <span class="icon icon-conversation" aria-hidden="true"></span>
        <span class="item-text"><span class="item-title">App build</span><span class="muted">branch <code><%= build.branch %></code></span></span>
      </a></li>
      <% } %>
    </ul>
    <% } %>
  </div>
  <% } %>

  <div class="card">
    <h2>New design</h2>
    <form action="/f/<%= it.folder.id %>/designs" method="post">
      <div class="fields">
        <label class="field">
          <span class="f">Title</span>
          <input name="title" value="<%= it.form.title %>" placeholder="Sign up" autocomplete="off"
                 <% if (it.form.errors.title) { %>ko-invalid-server="<%= it.form.errors.title %>"<% } %>>
          <% if (it.form.errors.title) { %><span class="err"><%= it.form.errors.title %></span><% } %>
        </label>
        <label class="field">
          <span class="f">Area <span class="muted">(optional)</span></span>
          <input name="area" value="<%= it.form.area %>" placeholder="onboarding" autocomplete="off" list="areas"
                 <% if (it.form.errors.area) { %>ko-invalid-server="<%= it.form.errors.area %>"<% } %>>
          <% if (it.form.errors.area) { %><span class="err"><%= it.form.errors.area %></span><% } %>
          <datalist id="areas">
            <% for (const group of it.groups) { if (group.area) { %><option value="<%= group.area %>"></option><% } } %>
          </datalist>
        </label>
      </div>
      <%/* Two kinds of design are the folder's, one each: the design system (the
           app's vocabulary) and the shell (its layouts). Each is offered until
           the folder has one. */%>
      <% const kind = it.form.kind ?? 'design'; %>
      <fieldset class="kinds">
        <legend class="sr-only">Kind</legend>
        <label class="check"><input type="radio" name="kind" value="design" <% if (kind === 'design') { %>checked<% } %>> <span>A design <span class="muted">· usually one feature</span></span></label>
        <% if (!it.system) { %>
        <label class="check"><input type="radio" name="kind" value="system" <% if (kind === 'system') { %>checked<% } %>> <span>The folder’s design system <span class="muted">· its tokens and components; every other design uses it</span></span></label>
        <% } %>
        <% if (!it.shell) { %>
        <label class="check"><input type="radio" name="kind" value="shell" <% if (kind === 'shell') { %>checked<% } %>> <span>The app’s shell <span class="muted">· its layouts; every other design renders in it</span></span></label>
        <% } %>
      </fieldset>
      <% if (it.system || it.shell) { %>
      <p class="muted">
        <% if (it.system) { %>Designs here use the design system <a href="/f/<%= it.folder.id %>/d/<%= it.system.id %>"><%= it.system.title %></a>.<% } %>
        <% if (it.shell) { %>They render in the shell <a href="/f/<%= it.folder.id %>/d/<%= it.shell.id %>"><%= it.shell.title %></a>.<% } %>
      </p>
      <% } %>
      <% if (it.form.errors.kind) { %><span class="err"><%= it.form.errors.kind %></span><% } %>
      <%/* Asked once, the first time a design is made: the app's stack, which
           its designs are written in. The default is one click; another stack
           is a quiet option (step 8). */%>
      <% if (!it.app.stack) { %>
      <div class="stack-choice">
        <p class="muted">Designs are written as the app’s own views. The app will be <strong><%= it.defaultStack %></strong>.</p>
        <details>
          <summary class="muted">Choose another stack</summary>
          <label class="field">
            <span class="f">The app’s stack</span>
            <input name="stack" placeholder="ASP.NET Core MVC with Razor" autocomplete="off">
          </label>
          <p class="muted">Its app is built first, with a design host, and designs are then written in its language. The design system can be designed straight away.</p>
        </details>
      </div>
      <% } %>
      <div class="rowbtns">
        <button class="btn small primary" type="submit"><span class="icon icon-add" aria-hidden="true"></span>Create design</button>
      </div>
    </form>
  </div>

  <div class="card" id="reading">
    <h2>What the agent can read</h2>
    <p class="sec">This folder, and any folders you add here, such as another repository whose CSS a design system should start from. Nothing else on this machine. The agent writes only inside the design it’s working on.</p>
    <ul class="list">
      <li><span class="item"><span class="icon icon-folder" aria-hidden="true"></span>
        <span class="item-text"><span class="item-title"><%= it.folder.name %></span><span class="muted"><%= it.folder.path %></span></span></span></li>
      <% for (const reference of it.references) { %>
      <li>
        <span class="item">
          <span class="icon icon-folder" aria-hidden="true"></span>
          <span class="item-text"><span class="item-title"><%= reference.name %></span><span class="muted"><%= reference.path %></span></span>
          <span class="spacer"></span>
          <form action="/f/<%= it.folder.id %>/references/remove" method="post">
            <input type="hidden" name="path" value="<%= reference.path %>">
            <button class="btn small ghost" type="submit" aria-label="Stop reading <%= reference.name %>"><span class="icon icon-close" aria-hidden="true"></span></button>
          </form>
        </span>
      </li>
      <% } %>
    </ul>
    <form class="add-reference" action="/f/<%= it.folder.id %>/references" method="post">
      <label class="f" for="reference-path">Add a folder</label>
      <div class="inline">
        <input id="reference-path" name="path" value="<%= it.reference.value %>" placeholder="C:\Projects\another-app" autocomplete="off" spellcheck="false"
               <% if (it.reference.error) { %>ko-invalid-server="<%= it.reference.error %>" aria-describedby="reference-error"<% } %>>
        <button class="btn small" type="button" data-pick-folder data-desktop-only>Choose…</button>
        <button class="btn small" type="submit">Add</button>
      </div>
      <% if (it.reference.error) { %><span class="err" id="reference-error"><%= it.reference.error %></span><% } %>
    </form>
  </div>
</section>
