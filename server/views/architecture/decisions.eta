<%/* Every decision, newest first, from decisions/<id>.md. Search by id or
     title as you type, and show one status: the list follows both, and the
     route filters (?q=, ?status=). Each opens in the drawer. Without script,
     Show reloads the page with them. */%>
<% const a = it, base = `/f/${a.project.id}/architecture`, q = it.$query?.q ?? '', status = it.$query?.status ?? '';
   const statuses = [['', 'statusAll', 'All'], ['proposed', 'statusProposed', 'Proposed'], ['accepted', 'statusAccepted', 'Accepted'], ['superseded', 'statusSuperseded', 'Superseded']]; %>
<div class="center architecture" ko-item>
  <div class="stack gap-6">
    <div class="stack gap-2">
      <nav class="crumbs" aria-label="Where you are"><a href="/">Projects</a><span aria-hidden="true">›</span><a href="/f/<%= a.project.id %>"><%= a.project.name %></a><span aria-hidden="true">›</span><a href="<%= base %>">Architecture</a></nav>
      <h1>Decisions</h1>
      <p class="secondary">Why <%= a.project.name %> is built the way it is. An agent proposes one when a change would go against the architecture; it’s accepted when its branch is merged into main.</p>
    </div>

    <section class="card" aria-label="Decisions">
      <form class="cluster gap-3" method="get" action="<%= base %>/decisions" role="search" aria-label="Decisions">
        <input class="decisions-search" type="search" id="q" name="q" value="<%= q %>" placeholder="Search by id or title" aria-label="Search decisions" autocomplete="off">
        <span class="segmented" role="radiogroup" aria-label="Show">
          <% for (const [value, id, label] of statuses) { %>
          <label class="btn small"><input class="sr-only" type="radio" name="status" id="<%= id %>" value="<%= value %>"<% if (status === value) { %> checked<% } %>><%= label %></label>
          <% } %>
        </span>
        <noscript><button class="btn small" type="submit">Show</button></noscript>
      </form>
      <div class="stack gap-3" ko-as="decisionList" aria-live="polite"
           calc-ko-source="'<%= base %>/decision-list?q=' + encode(q.value) + '&status=' + (statusProposed.selected ? 'proposed' : statusAccepted.selected ? 'accepted' : statusSuperseded.selected ? 'superseded' : '')"
           ko-invoke="input:q change:statusAll change:statusProposed change:statusAccepted change:statusSuperseded" ko-debounce="250"><%~ include('./_decisions', a) %></div>
      <div class="notice danger" role="alert" visible-when-unreachable="decisionList">
        <p>Prelude couldn’t read the decisions. Try again in a moment.</p>
        <div class="cluster actions"><button class="btn small" type="button" command="--koda-retry" ko-for="decisionList">Try again</button></div>
      </div>
    </section>
  </div>
</div>
