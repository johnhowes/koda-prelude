<%/* One transcript entry. Renders nothing for entries that show nothing
     (a tool's successful result, a turn that ended normally). */%>
<% const e = it.entry; %>
<% if (e.type === 'user') { %>
<li class="entry user"><div class="bubble"><%= e.text %></div></li>
<% } else if (e.type === 'text') { %>
<li class="entry agent"><div class="say markdown"><%~ e.html %></div></li>
<% } else if (e.type === 'tool') { %>
<li class="entry tool"><span class="tool-name"><%= e.name %></span> <span class="tool-summary"><%= e.summary %></span></li>
<% } else if (e.type === 'tool-result' && e.error) { %>
<li class="entry tool failed">
  <details><summary><%= e.name ?? 'Tool' %> was refused or failed</summary><pre><%= e.text %></pre></details>
</li>
<% } else if (e.type === 'check' && e.failures.length) { %>
<li class="entry note failed">
  <details open><summary><%= e.failures.length === 1 ? '1 page doesn’t' : `${e.failures.length} pages don’t` %> render. The agent is told with your next message.</summary>
  <ul class="check-list"><% for (const f of e.failures) { %><li><code><%= f.path %></code><% if (f.state) { %> · <%= f.state %><% } %>: <%= f.error %></li><% } %></ul></details>
</li>
<% } else if (e.type === 'check') { %>
<li class="entry note">Prelude rendered every page and form in every state<%= e.rendered ? ` (${e.rendered})` : '' %>, and they all render.</li>
<% } else if (e.type === 'next') { %>
<%/* After a build turn (10.7): where the app is running, and what's next,
     from the turn's check. Shown to the person, never told to the agent. */%>
<li class="entry note next">
  <% if (e.app?.running) { %><p>The app on this branch, with its own data, is running at <code><%= e.app.url %></code> · <a href="<%= e.app.open %>" target="_blank">Open<span class="icon icon-external" aria-hidden="true"></span></a></p><% } %>
  <% if (e.firstPorted) { %><p>The design window now shows the app’s own views for the pages built, with the design’s states as their data.</p><% } %>
  <p><strong>Next:</strong>
  <% if (!e.built) { %>
    <%= e.group %> isn’t built yet. Send the next message to carry on.
  <% } else if (!e.checked) { %>
    Prelude didn’t check the pages this turn (see above). Once they’re checked, finish the branch on <a href="<%= e.finish.url %>">the project page</a>: <%= e.finish.label %>.
  <% } else if (e.failures) { %>
    <%= e.failures === 1 ? '1 page doesn’t' : `${e.failures} pages don’t` %> render yet. The agent is told with your next message.
  <% } else { %>
    <% if (e.differ) { %><%= e.differ === 1 ? '1 page differs' : `${e.differ} pages differ` %> from the approved screens: look at them in the design window, and if they’re right, Approve again in the design bar. Then<% } else { %>When you’re happy with it,<% } %>
    finish the branch on <a href="<%= e.finish.url %>">the project page</a>: <%= e.finish.label %>.
  <% } %>
  </p>
</li>
<% } else if (e.type === 'note') { %>
<li class="entry note<%= e.failed ? ' failed' : '' %>"><%= e.text %></li>
<% } else if (e.type === 'turn' && e.stopped) { %>
<li class="entry note">Stopped.</li>
<% } else if (e.type === 'turn' && !e.ok) { %>
<li class="entry note failed"><%= e.error ?? 'The agent stopped with an error.' %></li>
<% } %>
<%/* Shown to the person, not told to the agent: a page that renders
     differently from its approved snapshot was probably asked for. */%>
<% if (e.type === 'check' && e.warnings?.length) { %>
<li class="entry note failed">
  <details open><summary><%= e.warnings.length === 1 ? '1 rule points' : `${e.warnings.length} rules point` %> at nothing in the design. The agent is told with your next message.</summary>
  <ul class="check-list"><% for (const warning of e.warnings) { %><li><%= warning %></li><% } %></ul></details>
</li>
<% } %>
<% if (e.type === 'check' && e.ahead?.length) { %>
<li class="entry note">
  <details><summary>The design is ahead of the app: the states have <%= e.ahead.length === 1 ? 'a field' : `${e.ahead.length} fields` %> the app’s models don’t yet. Building it adds them.</summary>
  <ul class="check-list"><% for (const member of e.ahead) { %><li><code><%= member %></code></li><% } %></ul></details>
</li>
<% } %>
<% if (e.type === 'check' && e.differ?.length) { %>
<li class="entry note">
  <details><summary><%= e.differ.length === 1 ? '1 page differs' : `${e.differ.length} pages differ` %> from the approved screens. If that’s what you asked for, approve them again in the design bar.</summary>
  <ul class="check-list"><% for (const name of e.differ) { %><li><code><%= name %></code></li><% } %></ul></details>
</li>
<% } %>
