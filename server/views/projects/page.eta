<%/* A project's page: the work (what needs the person here, what's in
     progress on branches, and every design) beside the project's setup (the
     app, and what the agent can read). The work and the app reload whenever
     the server says something changed, down the app's live channel, and
     every five minutes for what Prelude can't see happen (a pull request
     merged on the Git server); the designs reload only when designs change.
     New design is the page's one primary action, and opens in the modal.
     A project with no designs yet is the way to make the first. The route
     filters the designs by ?q= and ?stage=, as the designs' own region does. */%>
<% const p = it, q = it.$query?.q ?? '', stage = it.$query?.stage ?? '';
   const started = (p.designs ?? []).length + (p.inProgress ?? []).length > 0 || Boolean(q || stage);
   const stages = [['', 'stageAll', 'All'], ['ready', 'stageReady', 'Ready to build'], ['designing', 'stageDesigning', 'Still designing']]; %>
<div class="center wide project" ko-item>
  <div class="stack gap-8">
    <div class="cluster gap-4">
      <div class="stack gap-1">
        <nav class="crumbs" aria-label="Where you are"><a href="/">Projects</a></nav>
        <h1><%= p.name %></h1>
        <span class="muted project-path"><%= p.path %></span>
      </div>
      <% if (started) { %>
      <span class="spacer"></span>
      <a class="btn primary" href="/f/<%= p.id %>/designs/new" ko-target="modal?"><span class="icon icon-add" aria-hidden="true"></span>New design…</a>
      <% } %>
    </div>

    <% if (p.appError) { %>
    <div class="notice danger" role="alert"><p><%= p.appError %></p></div>
    <% } %>

    <div class="split" style="--side: 20rem">
      <div class="stack gap-6">
        <% if (!started) { %>
        <div class="empty page">
          <span class="icon icon-screen" aria-hidden="true"></span>
          <div class="stack gap-2">
            <h2>Design the first feature</h2>
            <p class="secondary">A design describes one feature, written as the app’s own views with real-looking data. It grows over sessions with the agent, then is built into the app on a branch of its own.</p>
          </div>
          <div class="cluster actions">
            <a class="btn primary large" href="/f/<%= p.id %>/designs/new" ko-target="modal?"><span class="icon icon-add" aria-hidden="true"></span>Create the first design…</a>
          </div>
          <% if (!p.system || !p.shell) { %>
          <p class="muted">Or start with what every design uses:
            <% if (!p.system) { %><a href="/f/<%= p.id %>/designs/new?kind=system" ko-target="modal?">the design system</a><% } %><% if (!p.system && !p.shell) { %> or <% } %><% if (!p.shell) { %><a href="/f/<%= p.id %>/designs/new?kind=shell" ko-target="modal?">the app shell</a><% } %>.</p>
          <% } %>
        </div>
        <% } else { %>
        <div class="stack gap-6" ko-as="work" ko-source="/f/<%= p.id %>/work" ko-invoke="event:needs-changed event:projects-changed every:300000"><%~ include('./_work', p) %></div>
        <div class="notice danger" role="alert" visible-when-unreachable="work">
          <p>Prelude couldn’t read this project’s branches. What’s shown may be out of date; try again in a moment.</p>
          <div class="cluster actions"><button class="btn small" type="button" command="--koda-retry" ko-for="work">Try again</button></div>
        </div>

        <section class="card" aria-labelledby="designs-title">
          <h2 id="designs-title">Designs</h2>
          <%/* Search as you type, and a filter: the list follows both. Without
               script, Show reloads the page with them. */%>
          <form class="cluster gap-3" method="get" action="/f/<%= p.id %>" role="search" aria-label="Designs">
            <input class="designs-search" type="search" id="q" name="q" value="<%= q %>" placeholder="Search by title or area" aria-label="Search designs" autocomplete="off">
            <span class="segmented" role="radiogroup" aria-label="Show">
              <% for (const [value, id, label] of stages) { %>
              <label class="btn small"><input class="sr-only" type="radio" name="stage" id="<%= id %>" value="<%= value %>"<% if (stage === value) { %> checked<% } %>><%= label %></label>
              <% } %>
            </span>
            <noscript><button class="btn small" type="submit">Show</button></noscript>
          </form>
          <div class="stack gap-5" ko-as="designList" aria-live="polite"
               calc-ko-source="'/f/<%= p.id %>/designs?q=' + encode(q.value) + '&stage=' + (stageReady.selected ? 'ready' : stageDesigning.selected ? 'designing' : '')"
               ko-invoke="input:q change:stageAll change:stageReady change:stageDesigning event:projects-changed" ko-debounce="250"><%~ include('./_designs', p) %></div>
          <div class="notice danger" role="alert" visible-when-unreachable="designList">
            <p>Prelude couldn’t read this project’s designs. Try again in a moment.</p>
            <div class="cluster actions"><button class="btn small" type="button" command="--koda-retry" ko-for="designList">Try again</button></div>
          </div>
        </section>
        <% } %>
      </div>
      <aside class="side stack gap-6" aria-label="The project’s setup">
        <% if (started || p.app.status !== 'none') { %>
        <section class="card" id="app" aria-labelledby="app-title" ko-as="app" ko-source="/f/<%= p.id %>/app" ko-invoke="event:projects-changed"><%~ include('./_app', p) %></section>
        <% } %>
        <%~ include('./_reading', p) %>
      </aside>
    </div>
  </div>
</div>
