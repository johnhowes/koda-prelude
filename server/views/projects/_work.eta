<%/* The project's work: what needs the person here (Home's list, for this
     project alone), the designs and fixes in progress on their branches,
     and what the person has asked lately. It's a region of its own, so the
     page reloads it whenever something changes; the designs list is
     another, which reloads only when designs do.

     A branch's card opens where its work is now (R-e5n): a build running,
     its build session; a build stopped, or stories on the branch, the
     design's Build page; otherwise (still designing, or a design turn
     running) the design's page, which opens its latest session. A fix's
     opens the fix's page.

     Asked lately is the conversations about the project that have no
     branch: questions, and problems not yet fixed. They're kept on this
     computer, not in the project (R-2qz). Fixed on a branch, one moves to In
     progress (R-x8d). Newest first, as the app gives them.

     Clean up is a button in In progress's heading, with a count (or a line
     of its own, with nothing in progress), while Prelude has found branches, worktrees or folders it
     leaves to the person, with how many. */%>
<% const p = it, needs = [...(p.needs ?? [])].reverse(), inProgress = p.inProgress ?? [], asked = p.asked ?? [];
   const removed = p.cleanup?.removed ?? {};
   const toClean = (p.cleanup?.items ?? []).filter(item => !item.working && removed[item.id] !== true && removed[item.id] !== 'true').length;
   const kinds = {
     question: { label: 'Asking you', icon: 'question', tone: 'accent' },
     stopped: { label: 'Build stopped', icon: 'code', tone: 'warn' },
     finished: { label: 'Turn finished', icon: 'session', tone: '' },
     'to-build': { label: 'Ready to build', icon: 'code', tone: '' },
     'pull-request': { label: 'Pull request open', icon: 'push', tone: '' },
   };
   const kindPill = kind => kind === 'system' ? 'Design system' : kind === 'shell' ? 'App shell' : kind === 'fix' ? 'Fix' : null;
   const kindIcon = kind => kind === 'system' ? 'design-system' : kind === 'fix' ? 'agent' : 'screen';
   const openOf = item => {
     const stories = item.stories ?? [];
     if (item.design.kind === 'fix') return item.url;
     if (item.building && !item.building.stopped) return stories.find(story => story.state === 'building' && story.session)?.session ?? item.buildUrl;
     if (item.building) return item.buildUrl;
     if (item.working) return item.url;
     return stories.length ? item.buildUrl : item.url;
   };
   /* Only the stories the agent has written: one is written when asked for (R-w3n). */
   const toBuild = inProgress.flatMap(item => item.stories.filter(story => story.state !== 'built' && story.story).map(story => story.story)).join('\n\n---\n\n'); %>
<% if (needs.length) { %>
<section class="card" aria-labelledby="needs-title">
  <h2 id="needs-title">Needs you</h2>
  <ul class="list">
    <% for (const need of needs) { const kind = kinds[need.kind]; const away = need.url.startsWith('http'); %>
    <li>
      <a class="item" href="<%= need.url %>"<% if (away) { %> target="_blank" rel="noopener"<% } %>>
        <span class="icon icon-<%= kind.icon %>" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= need.design %><span class="pill <%= kind.tone %>"><%= kind.label %></span></span>
          <span class="secondary"><%= need.says %></span>
          <span class="muted"><%= need.when %></span>
        </span>
        <% if (away) { %><span class="icon icon-external" aria-hidden="true"></span><span class="sr-only">(opens on your Git server)</span><% } %>
      </a>
    </li>
    <% } %>
  </ul>
</section>
<% } %>

<% if (inProgress.length) { %>
<section class="card" aria-labelledby="in-progress-title">
  <div class="cluster gap-2">
    <h2 id="in-progress-title">In progress <span class="muted"><%= inProgress.length %></span></h2>
    <% if (toClean) { %>
    <span class="spacer"></span>
    <a class="btn small ghost" href="/f/<%= p.id %>/cleanup" ko-target="modal?" title="<%= toClean === 1 ? '1 branch or folder' : `${toClean} branches and folders` %> Prelude doesn’t tidy up by itself">Clean up…<span class="pill"><%= toClean %></span></a>
    <% } %>
  </div>
  <ul class="stack gap-6 in-progress">
    <% for (const item of inProgress) { %>
    <li class="stack gap-2">
      <a class="item" href="<%= openOf(item) %>">
        <span class="icon icon-<%= kindIcon(item.design.kind) %>" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= item.design.title %><% if (kindPill(item.design.kind)) { %><span class="pill"><%= kindPill(item.design.kind) %></span><% } %></span>
          <span class="muted"><%= item.design.area ? `${item.design.area} · ` : '' %>prelude/<%= item.design.id %></span>
        </span>
      </a>
      <%~ include('./_branch', item) %>
    </li>
    <% } %>
  </ul>
  <% if (toBuild) { %>
  <details class="disclosure" ko-item>
    <summary>Copy every story still to build</summary>
    <div class="stack gap-2">
      <textarea class="story" ko-as="stories" rows="12" readonly aria-label="Every story still to build"><%= toBuild %></textarea>
      <div class="cluster actions"><button class="btn small" type="button" ko-as="copyAll">Copy</button></div>
    </div>
    <script type="koda">
      // Copying to the clipboard is an action on the platform, not a value.
      const { stories, copyAll } = koda.scope();
      copyAll.element.addEventListener('click', async () => {
        await navigator.clipboard.writeText(stories.element.value);
        copyAll.element.textContent = 'Copied';
      });
    </script>
  </details>
  <% } %>
</section>
<% } else if (toClean) { %>
<div class="cluster gap-2">
  <span class="muted"><%= toClean === 1 ? '1 branch or folder' : `${toClean} branches and folders` %> Prelude doesn’t tidy up by itself.</span>
  <a class="btn small ghost" href="/f/<%= p.id %>/cleanup" ko-target="modal?">Clean up…</a>
</div>
<% } %>

<% if (asked.length) { %>
<section class="card" aria-labelledby="asked-title">
  <h2 id="asked-title">Asked lately</h2>
  <ul class="list">
    <% for (const question of asked) { %>
    <li>
      <a class="item" href="<%= question.url %>">
        <span class="icon icon-agent" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= question.title %><% if (question.state === 'working') { %><span class="pill accent"><span class="pulse" aria-hidden="true"></span>Working</span><% } else if (question.state === 'asking') { %><span class="pill accent">Asking you</span><% } %></span>
          <% if (question.says) { %><span class="secondary"><%= question.says %></span><% } %>
          <span class="muted"><%= question.when %></span>
        </span>
      </a>
    </li>
    <% } %>
  </ul>
  <p class="muted">Kept on this computer, not in the project. Nothing in them changes the project until it’s fixed on a branch.</p>
</section>
<% } %>
