<%/* Reference: the design system and the architecture to read, without
     opening a design session, which is how they're mostly used. Each opens
     its own pages in the app (the architecture's overview; the design
     system's tokens, components and guidelines); changing one is its
     design's, under Designs. Both rows always show, so it's clear the
     project can have them (R-x4b): one with nothing in it yet is the way to
     start it. A design system not made yet opens New design with its kind
     picked, and one with no components its design; the architecture's page
     drafts one that isn't written. The app shell isn't here: its gallery is
     for changing it. `it` is the project. */%>
<% const p = it, components = p.system?.components ?? 0, parts = p.architecture?.parts ?? 0, decisions = p.architecture?.decisions ?? 0;
   const counted = (n, one, many) => `${n} ${n === 1 ? one : many}`; %>
<section class="card" id="reference" aria-labelledby="reference-title">
  <h2 id="reference-title">Reference</h2>
  <p class="secondary">What every design and build here follows.</p>
  <ul class="list">
    <li>
      <% if (components) { %>
      <a class="item" href="/f/<%= p.id %>/system">
      <% } else if (p.system) { %>
      <a class="item" href="/f/<%= p.id %>/d/<%= p.system.id %>">
      <% } else { %>
      <a class="item" href="/f/<%= p.id %>/designs/new?kind=system" ko-target="modal?">
      <% } %>
        <span class="icon icon-design-system" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= p.system?.title ?? 'Design system' %></span>
          <% if (components) { %>
          <span class="muted">Tokens, <%= counted(components, 'component', 'components') %> and the guidelines</span>
          <% } else if (p.system) { %>
          <span class="muted">Nothing designed yet · design it with the agent</span>
          <% } else { %>
          <span class="muted">Not made yet · its tokens and components, which every design uses</span>
          <% } %>
        </span>
      </a>
    </li>
    <li>
      <a class="item" href="/f/<%= p.id %>/architecture">
        <span class="icon icon-document" aria-hidden="true"></span>
        <span class="item-text">
          <span class="item-title"><%= p.architecture?.title ?? 'Architecture' %></span>
          <% if (parts) { %>
          <span class="muted"><%= counted(parts, 'part', 'parts') %> and <%= counted(decisions, 'decision', 'decisions') %></span>
          <% } else { %>
          <span class="muted">Nothing written yet · draft it from the code</span>
          <% } %>
        </span>
      </a>
    </li>
  </ul>
</section>
