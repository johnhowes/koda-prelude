<%/* New design, in the modal: its title and area, and its kind while the
     project lacks a design system or an app shell (one each). The first time,
     it also says which stack the app will be. A title left empty comes back
     into the fields alone, with what was typed; made, the design opens.
     ?kind=system or ?kind=shell picks that kind, from the first-run page;
     ?kind=architecture, from the Architecture page (prelude/architecture),
     makes the project's architecture, which has no other kind to pick.
     `it` is the project; `it.$fields` the fields as refused, on a cold load. */%>
<% const p = it, kind = ['system', 'shell', 'architecture'].includes(it.$query?.kind) ? it.$query.kind : 'design';
   const areas = [...new Set((p.designs ?? []).concat((p.inProgress ?? []).map(item => item.design)).map(design => design.area).filter(Boolean))]; %>
<div class="stack gap-4" ko-item>
  <h2>New design</h2>
  <% if (kind === 'architecture') { %>
  <p class="secondary">The project’s architecture: the agent drafts it from the code, and every agent reads it before it changes anything.</p>
  <% } else { %>
  <p class="secondary">A design usually describes one feature, and grows over many sessions with the agent.</p>
  <% } %>
  <form class="stack" action="/f/<%= p.id %>/designs" method="post" ko-target="fields">
    <div ko-as="fields"><%~ include('./_new-design-fields', it.$fields ?? {}) %></div>
    <datalist id="new-design-areas">
      <% for (const area of areas) { %><option value="<%= area %>"></option><% } %>
    </datalist>
    <% if (kind === 'architecture') { %>
    <input type="hidden" name="kind" value="architecture">
    <% } else if (!p.system || !p.shell) { %>
    <fieldset class="choices">
      <legend class="label">Kind</legend>
      <label class="choice"><input type="radio" name="kind" value="design"<% if (kind === 'design') { %> checked<% } %>> <span>A design <span class="muted">· usually one feature</span></span></label>
      <% if (!p.system) { %>
      <label class="choice"><input type="radio" name="kind" value="system"<% if (kind === 'system') { %> checked<% } %>> <span>The project’s design system <span class="muted">· its tokens and components; every other design uses it</span></span></label>
      <% } %>
      <% if (!p.shell) { %>
      <label class="choice"><input type="radio" name="kind" value="shell"<% if (kind === 'shell') { %> checked<% } %>> <span>The app’s shell <span class="muted">· its layouts; every other design renders in it</span></span></label>
      <% } %>
    </fieldset>
    <% } else { %>
    <input type="hidden" name="kind" value="design">
    <% } %>
    <%/* Asked once, the first time a design is made: the app's stack, which
         its designs are written in. The default is one click (step 8). */%>
    <% if (kind !== 'architecture' && !p.app.stack && p.app.status === 'none') { %>
    <div class="stack gap-2">
      <p class="muted">Designs are written as the app’s own views. The app will be <strong><%= p.defaultStack %></strong>.</p>
      <details class="disclosure">
        <summary>Choose another stack</summary>
        <label class="field">
          <span class="label">The app’s stack</span>
          <input name="stack" placeholder="ASP.NET Core MVC with Razor" autocomplete="off">
          <span class="hint">Its app is built first, with a design host, and designs are then written in its language. The design system can be designed straight away.</span>
        </label>
      </details>
      <label class="choice"><input type="checkbox" name="existing" value="yes"> <span class="muted">This project already has an app: connect it instead of building one</span></label>
    </div>
    <% } %>
    <div class="cluster actions">
      <button class="btn primary" type="submit"><span class="icon icon-add" aria-hidden="true"></span>Create design</button>
    </div>
  </form>
</div>
