<%/* A design's page (the chat beside the design surface): the bar, then the
     page filling the rest of the window (the shell's workspace layout,
     prelude/prelude-shell). The window doesn't scroll; the page's panels do,
     each its own. The page opens its own live channel, so the layout is
     given none. */%>
<!doctype html>
<html lang="en">
<head>
<%~ include('./_head', { ...it, system: true, styles: '/static/workspace.css' }) %>
</head>
<body class="shell fill">
<%~ include('./_bar', it.layout ?? {}) %>
<main id="main" class="shell-main" ko-scope="/" ko-location="<%= it.path %>" ko-history><%~ it.body %></main>
<%~ include('./_regions', it) %>
</body>
</html>
