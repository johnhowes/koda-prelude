<%/* Prelude's pages (Projects, a project, Build): the bar, then the page, which
     scrolls with the window (the shell's app layout, prelude/prelude-shell).
     The page holds itself to a readable width (.center); the shell gives it
     its room above and below. The root keeps .prelude, which prelude.css
     scopes its pages' rules to and desktop.js marks; the main region keeps
     its id, #workspace. `system` is false for pages still in ds/v1. */%>
<!doctype html>
<html lang="en">
<head>
<%~ include('./_head', { ...it, system: it.system ?? true, styles: '/static/prelude.css' }) %>
</head>
<body class="shell prelude">
<%~ include('./_bar', it.layout ?? {}) %>
<main id="workspace" class="shell-main" ko-scope="/" ko-location="<%= it.path %>" ko-history><%~ it.body %></main>
<%~ include('./_regions', it) %>
</body>
</html>
