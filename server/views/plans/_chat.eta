<%/* The plan's chat: its session, as the design shows it (prelude/coordinator,
     _chat): the transcript, the agent working, and the message box. Not yet
     the app's own chat (server/views/_chat.eta) with its session menu, Tools,
     queue, dictation and images: see the design's NOTES.md. The transcript
     reloads when the plan moves (plans-changed). */%>
<% const p = it, base = `/f/${p.project.id}/plans/${p.id}`; %>
<section class="panel side chat" aria-label="Planning session">
  <div class="toolbar">
    <span class="icon icon-session" aria-hidden="true"></span><span class="muted">Planning session</span>
  </div>
  <div class="transcript-scroll">
    <ol id="planTranscript" class="transcript" aria-live="polite" ko-source="<%= base %>/transcript" ko-invoke="event:plans-changed"><%~ include('./_transcript', p) %></ol>
  </div>
  <div id="planComposer" ko-region><%~ include('./_composer', p) %></div>
</section>
