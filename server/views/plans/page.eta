<%/* A plan's page is its session, as a design's page is: a one-line header,
     then the chat beside the plan, filling the window. The person and the
     agent shape the plan in the chat (add a step, change what one waits for,
     rewrite a prompt) and see it change beside them; what Prelude does as
     the plan runs (a step started, a pull request merged) is said in the
     chat too, so the agent knows it with the next message.

     Drafted, nothing starts until the person starts the plan (R-h9w): that's
     the page's one primary action then. Running, it can be paused, which
     holds back steps that haven't started (R-c7n). The plan is drafted on
     its own branch, named in the header, and starting it puts it into main
     so the whole project's Prelude sees it (R-q2x). Each person sees the
     same plan from their own computer; `me` says who's here. `it` is the
     plan (Plan, server/plans-page.js). */%>
<% const p = it, project = p.project, base = `/f/${project.id}/plans/${p.id}`, steps = p.steps ?? [];
   const merged = steps.filter(step => step.state === 'merged').length;
   const waiting = steps.filter(step => step.state === 'open' || (p.me && step.owner === p.me && ['asking', 'ready', 'stopped'].includes(step.state))).length;
   const stage = !steps.length ? ['Drafting', 'The agent is reading the project and drafting the steps.']
     : p.status === 'planning' ? ['Drafted', 'Read the steps, change what you like here or in the chat, then start the plan.']
     : p.status === 'paused' ? ['Paused', `${merged} of ${steps.length} steps merged. No step starts until you resume it.`]
     : p.status === 'done' ? ['Finished', `Every step is merged into main, ${p.finished}.`]
     : ['Running', `${merged} of ${steps.length} steps merged${waiting ? `; ${waiting === 1 ? '1 needs' : `${waiting} need`} you` : ''}.`]; %>
<div class="stack gap-3 plan fills" ko-item>
  <header class="cluster gap-3">
    <div class="stack gap-0">
      <nav class="crumbs" aria-label="Where you are"><a href="/">Projects</a><span aria-hidden="true">›</span><a href="/f/<%= project.id %>"><%= project.name %></a><span aria-hidden="true">›</span><a href="/f/<%= project.id %>/plans">Plans</a></nav>
      <h1><%= p.title || 'A new plan' %></h1>
      <p class="secondary"><strong><%= stage[0] %></strong> · <%= stage[1] %></p>
    </div>
    <span class="spacer"></span>
    <div class="cluster">
      <% if (p.branch) { %><span class="muted" title="The plan is drafted on a branch of its own. Starting it puts it into main, so everyone on the project sees it; a later change goes the same way."><span class="icon icon-push" aria-hidden="true"></span> <code><%= p.branch %></code></span><% } %>
      <% if (p.status === 'planning' && steps.length) { %>
      <form action="<%= base %>/start" method="post">
        <input type="hidden" name="status" value="running">
        <button class="btn small primary" type="submit" title="Puts the plan into main, so everyone on the project sees it. Steps that wait for nothing start on their owners’ computers; each of the others once what it waits for is done."><span class="icon icon-run" aria-hidden="true"></span>Start the plan</button>
      </form>
      <% } else if (p.status === 'running') { %>
      <form action="<%= base %>/pause" method="post">
        <input type="hidden" name="status" value="paused">
        <button class="btn small" type="submit" title="No step starts until you resume it. Steps already working carry on.">Pause</button>
      </form>
      <% } else if (p.status === 'paused') { %>
      <form action="<%= base %>/start" method="post">
        <input type="hidden" name="status" value="running">
        <button class="btn small primary" type="submit"><span class="icon icon-run" aria-hidden="true"></span>Resume the plan</button>
      </form>
      <% } %>
    </div>
  </header>

  <div class="split gap-3 plan-workspace" style="--side: 26rem">
    <%~ include('./_chat', p) %>
    <section class="panel plan-surface" aria-label="The plan">
      <% if (p.status === 'paused') { %>
      <div class="notice warn" role="status"><p>The plan is paused. Steps already working carry on, and still ask you when they’re done.</p></div>
      <% } %>
      <div class="panel-body inset">
        <div class="split" style="--side: 18rem">
          <div class="stack gap-6">
            <div class="stack gap-6" id="planWork" ko-source="<%= base %>/work" ko-invoke="event:plans-changed"><%~ include('./_work', p) %></div>
            <div class="notice danger" role="alert" visible-when-unreachable="planWork">
              <p>Prelude couldn’t read where the plan’s steps stand. What’s shown may be out of date; try again in a moment.</p>
              <div class="cluster actions"><button class="btn small" type="button" command="--koda-retry" commandfor="planWork">Try again</button></div>
            </div>
          </div>
          <aside class="side stack gap-6" aria-label="About the plan">
            <section class="card" id="planBrief" ko-region aria-labelledby="brief-title"><%~ include('./_brief', p) %></section>
            <section class="card" id="planSettings" ko-region aria-labelledby="settings-title"><%~ include('./_settings', p) %></section>
          </aside>
        </div>
      </div>
    </section>
  </div>
</div>
