<%/* Needs you, while Prelude reads every project's branches: three rows the
     shape of what's coming. */%>
<div aria-busy="true">
  <span class="sr-only">Checking what needs you…</span>
  <ul class="list" aria-hidden="true">
    <% for (const width of ['45%', '60%', '35%']) { %>
    <li>
      <span class="item">
        <span class="item-text stack gap-2">
          <span class="skeleton" style="--w: <%= width %>"></span>
          <span class="skeleton" style="--w: 80%"></span>
        </span>
      </span>
    </li>
    <% } %>
  </ul>
</div>
